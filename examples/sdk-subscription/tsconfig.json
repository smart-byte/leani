      "../../site/node_modules/@types"
    ],
    "types": [
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "index.ts",
    "live-sync.ts",
    "../custom-node/client.ts",
    "../sdk-postgres/index.ts",
    "../sdk-stream/index.ts"
  ]
}
