{
  "extends": "../../packages/sdk/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@smart-byte/leani-sdk": [
        "./../../packages/sdk/src/index.ts"
      ],
      "@smart-byte/leani-sdk/*": [
        "./../../packages/sdk/src/*.ts"
      ]
    },
    "typeRoots": [
