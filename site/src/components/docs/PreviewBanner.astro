---
import buildMetadata from '../../generated/build-metadata.json';

const isPreview = buildMetadata.mode === 'preview';
---

{
  isPreview && (
    <aside class="preview-banner" data-pagefind-ignore>
      Preview documentation for <code>{buildMetadata.docsRef}</code>. Production docs are pinned to a published release.
    </aside>
  )
}

<style>
  @layer starlight.core {
    .preview-banner {
      background: color-mix(in srgb, var(--sl-color-accent) 16%, var(--sl-color-bg));
      border-block-end: 1px solid var(--sl-color-accent-low);
      color: var(--sl-color-text);
      font-size: var(--sl-text-sm);
      padding: 0.55rem 1rem;
      text-align: center;
    }

    code {
      color: var(--sl-color-accent-high);
      font-size: 0.92em;
    }
  }
</style>
