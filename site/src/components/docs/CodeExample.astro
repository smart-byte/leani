---
import { Code } from 'astro-expressive-code/components';
import { sourceUrl } from '../../config';
import { exampleSource, type ExampleId } from '../../lib/examples';

interface Props {
  example: ExampleId;
  title?: string;
}

const { example: id, title } = Astro.props;
const source = exampleSource(id);
const verifiedSourceUrl = sourceUrl(source.source.file);
---

<figure class="code-example" data-example-id={id}>
  <Code code={source.code} lang={source.language} title={title || source.title} />
  <figcaption>
    <span>{source.description}</span>
    <a href={verifiedSourceUrl}>Verified source</a>
  </figcaption>
</figure>

<style>
  .code-example {
    margin-block: 1.5rem;
  }

  figcaption {
    color: var(--sl-color-gray-3);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin-block-start: 0.45rem;
  }

  figcaption a {
    white-space: nowrap;
  }
</style>
