---
import { sourceUrl } from '../../config';

const filePath = Astro.locals.starlightRoute.entry.filePath.replaceAll('\\', '/');
const enabled = Astro.locals.starlightRoute.entry.data.editUrl !== false;
const marker = '/docs/';
const markerIndex = filePath.lastIndexOf(marker);
const relativePath = markerIndex >= 0 ? filePath.slice(markerIndex + marker.length) : undefined;
const editUrl = enabled && relativePath
  ? sourceUrl(`docs/${relativePath}`, 'edit')
  : undefined;
---

{
  editUrl && (
    <a class="edit-link print:hidden" href={editUrl}>
      Edit this page on GitHub
    </a>
  )
}

<style>
  @layer starlight.core {
    .edit-link {
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }

    .edit-link:hover {
      color: var(--sl-color-white);
    }
  }
</style>
