---
import { getCollection } from 'astro:content';
import { DOC_SECTIONS, DOC_STARTER_PAGES, docHref } from '../../lib/docs';

const currentId = Astro.locals.starlightRoute.entry.id;
const entries = (await getCollection('docs', ({ data }) => !data.draft)).sort((left, right) => {
  const sectionOrder = DOC_SECTIONS.indexOf(left.data.section) - DOC_SECTIONS.indexOf(right.data.section);
  return sectionOrder || left.data.order - right.data.order || left.data.title.localeCompare(right.data.title);
});
const starterIds = new Set<string>(DOC_STARTER_PAGES.map((page) => page.id));
const current = entries.find((entry) => entry.id === currentId);
const path = starterIds.has(currentId)
  ? DOC_STARTER_PAGES.map((page) => entries.find((entry) => entry.id === page.id)!)
  : entries.filter((entry) => !starterIds.has(entry.id) && entry.data.section === current?.data.section);
const currentIndex = path.findIndex((entry) => entry.id === currentId);
const previous = currentIndex > 0 ? path[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? path[currentIndex + 1] : undefined;
---

<nav class="pagination-links print:hidden" aria-label="Documentation pages">
  {
    previous && (
      <a href={docHref(previous.id)} rel="prev">
        <small>Previous</small>
        <span>{previous.data.title}</span>
      </a>
    )
  }
  {
    next && (
      <a href={docHref(next.id)} rel="next">
        <small>Next</small>
        <span>{next.data.title}</span>
      </a>
    )
  }
</nav>

<style>
  @layer starlight.core {
    .pagination-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
      gap: 1rem;
    }

    a {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.45rem;
      color: var(--sl-color-white);
      display: grid;
      gap: 0.2rem;
      padding: 0.9rem 1rem;
      text-decoration: none;
    }

    a:hover {
      border-color: var(--sl-color-accent);
    }

    a[rel='next'] {
      text-align: end;
    }

    small {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      text-transform: uppercase;
    }
  }
</style>
