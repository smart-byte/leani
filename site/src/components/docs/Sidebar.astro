---
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { DOC_SECTIONS, DOC_SECTION_LABELS, docHref } from '../../lib/docs';

const currentId = Astro.locals.starlightRoute.entry.id;
const entries = (await getCollection('docs', ({ data }) => !data.draft)).sort((left, right) => {
  const sectionOrder = DOC_SECTIONS.indexOf(left.data.section) - DOC_SECTIONS.indexOf(right.data.section);
  return sectionOrder || left.data.order - right.data.order || left.data.title.localeCompare(right.data.title);
});
---

<nav class="docs-nav" aria-label="Documentation">
  {
    DOC_SECTIONS.map((section) => {
      const sectionEntries = entries.filter((entry) => entry.data.section === section);
      if (sectionEntries.length === 0) return null;
      return (
        <section>
          <h2>{DOC_SECTION_LABELS[section]}</h2>
          <ul>
            {sectionEntries.map((entry) => (
              <li>
                <a href={docHref(entry.id)} aria-current={entry.id === currentId ? 'page' : undefined}>
                  <span>{entry.data.sidebar.label || entry.data.title}</span>
                  {entry.data.sidebar.badge && (
                    <Badge
                      text={entry.data.sidebar.badge.text}
                      variant={entry.data.sidebar.badge.variant}
                      size="small"
                    />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</nav>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  @layer starlight.core {
    .docs-nav {
      display: grid;
      gap: 1.5rem;
      padding-block: 0.5rem 1.5rem;
    }

    h2 {
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      margin: 0 0 0.4rem;
      text-transform: uppercase;
    }

    ul {
      display: grid;
      gap: 0.12rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      align-items: center;
      border-inline-start: 2px solid transparent;
      color: var(--sl-color-gray-3);
      display: flex;
      gap: 0.5rem;
      justify-content: space-between;
      padding: 0.38rem 0.65rem;
      text-decoration: none;
    }

    a:hover {
      color: var(--sl-color-white);
    }

    a[aria-current='page'] {
      background: var(--sl-color-accent-low);
      border-inline-start-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }

  }
</style>
