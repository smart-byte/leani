---
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { DOC_SECTIONS, DOC_SECTION_LABELS, DOC_STARTER_PAGES, docHref } from '../../lib/docs';

const currentId = Astro.locals.starlightRoute.entry.id;
const entries = (await getCollection('docs', ({ data }) => !data.draft)).sort((left, right) => {
  const sectionOrder = DOC_SECTIONS.indexOf(left.data.section) - DOC_SECTIONS.indexOf(right.data.section);
  return sectionOrder || left.data.order - right.data.order || left.data.title.localeCompare(right.data.title);
});
const starterIds = new Set<string>(DOC_STARTER_PAGES.map((page) => page.id));
---

<nav class="docs-nav" aria-label="Documentation">
  <section aria-labelledby="starter-heading">
    <h2 id="starter-heading">Start building</h2>
    <ul>
      {DOC_STARTER_PAGES.map((page) => (
        <li>
          <a href={docHref(page.id)} aria-current={page.id === currentId ? 'page' : undefined}>
            <span>{page.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  {
    DOC_SECTIONS.map((section) => {
      const sectionEntries = entries.filter((entry) => entry.data.section === section && !starterIds.has(entry.id));
      if (sectionEntries.length === 0) return null;
      return (
        <details open={sectionEntries.some((entry) => entry.id === currentId)}>
          <summary>{section === 'getting-started' ? 'More first-run help' : DOC_SECTION_LABELS[section]}</summary>
          <ul>
            {sectionEntries.map((entry) => (
              <li>
                <a href={docHref(entry.id)} aria-current={entry.id === currentId ? 'page' : undefined}>
                  <span>{entry.data.sidebar.label || entry.data.title}</span>
                  {entry.data.sidebar.badge && (
                    <Badge
                      text={entry.data.sidebar.badge.text}
                      variant={entry.data.sidebar.badge.variant}
                      size="small"
                    />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })
  }
</nav>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  @layer starlight.core {
    .docs-nav {
      display: grid;
      gap: 1.5rem;
      padding-block: 0.5rem 1.5rem;
    }

    h2, summary {
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      margin: 0 0 0.4rem;
      text-transform: uppercase;
    }

    summary { cursor: pointer; padding-block: 0.35rem; }
    details[open] summary { margin-bottom: 0.4rem; }

    ul {
      display: grid;
      gap: 0.12rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      align-items: center;
      border-inline-start: 2px solid transparent;
      color: var(--sl-color-gray-3);
      display: flex;
      gap: 0.5rem;
      justify-content: space-between;
      padding: 0.38rem 0.65rem;
      text-decoration: none;
    }

    a:hover {
      color: var(--sl-color-white);
    }

    a[aria-current='page'] {
      background: var(--sl-color-accent-low);
      border-inline-start-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }

  }
</style>
