---
import TerminalFrame from './TerminalFrame.astro';
import { QUICKSTART_URL } from '../config';
import { hlShell } from '../lib/highlight';
import { exampleSource } from '../lib/examples';

const boundedMainnetQuickstart = exampleSource('live-block-first-run').code;
const boundedMainnetQuery = exampleSource('live-block-node').code;
const shellLines = (source: string) => source.split('\n').map(hlShell);
---
<section id="quickstart" class="wrap section" aria-labelledby="quickstart-h">
  <p class="eyebrow mono">Ethereum Mainnet · no API key</p>
  <h2 id="quickstart-h"><span class="mono"># </span>Follow Ethereum blocks</h2>
  <p class="lede">
    <a href="/docs/getting-started/install/">Install the alpha from source</a>,
    then read block summaries directly from Ethereum's network with one command. On first use,
    Leani asks you to approve a checkpoint, a trusted starting point for checking the chain.
    Prepare a reusable node when you want queries and SDK subscriptions.
  </p>
  <div class="pair">
    <div>
      <p class="mono label">1 · inspect a first block</p>
      <TerminalFrame title="shell">
        <div class="command" data-copy-value={boundedMainnetQuickstart}>
          <span data-copy-source>
            {shellLines(boundedMainnetQuickstart).map((line) => <span class="t-line" set:html={line} />)}
          </span>
          <button type="button" class="copy mono" data-copy-button aria-label="Copy first-run commands">copy</button>
        </div>
      </TerminalFrame>
      <p class="status mono" role="status" aria-live="polite" data-copy-status></p>
    </div>
    <div>
      <p class="mono label">2 · prepare a reusable node</p>
      <TerminalFrame title="shell">
        <div class="command" data-copy-value={boundedMainnetQuery}>
          <span data-copy-source>
            {shellLines(boundedMainnetQuery).map((line) => <span class="t-line" set:html={line} />)}
          </span>
          <button type="button" class="copy mono" data-copy-button aria-label="Copy reusable node commands">copy</button>
        </div>
      </TerminalFrame>
      <p class="status mono" role="status" aria-live="polite" data-copy-status></p>
    </div>
  </div>
  <p class="after">
    Your first result may be a <span class="mono">preview</span> while Leani checks the block's place in Ethereum's chain.
    Rows marked <span class="mono">included</span> are on the followed chain and can still be reorged.
    Add <span class="mono">--finality finalized</span> to print only blocks Ethereum consensus has finalized.
    See the <a href={QUICKSTART_URL}>full quickstart</a>, then
    <a href="/docs/getting-started/bounded-mainnet/">index a bounded historical range</a>.
  </p>
</section>

<style>
  h2 { margin-top: 1rem; }
  .lede { color: var(--ink-dim); max-width: 66ch; margin-top: 1rem; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
  .pair > div { min-width: 0; }
  @media (max-width: 900px) { .pair { grid-template-columns: 1fr; } }
  .label { color: var(--ink-dim); font-size: 0.8rem; margin-bottom: 0.5rem; }
  .command { position: relative; min-width: 0; padding-right: 3.25rem; }
  .copy {
    position: absolute; top: 0; right: 0;
    border: 1px solid var(--panel-edge); border-radius: 5px;
    background: var(--bg); color: var(--ink-dim);
    padding: 0.25rem 0.45rem; cursor: pointer; font-size: 0.7rem;
  }
  .copy:hover { color: var(--accent); border-color: var(--accent-dim); }
  .status { min-height: 1.4em; color: var(--accent); font-size: 0.72rem; margin-top: 0.35rem; }
  .after { color: var(--ink-dim); margin-top: 1.5rem; overflow-wrap: anywhere; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#quickstart .command').forEach((command) => {
    const button = command.querySelector<HTMLButtonElement>('[data-copy-button]');
    const status = command.closest<HTMLElement>('.pair > div')?.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.dataset.copyValue ?? '');
        if (status) status.textContent = 'Copied to clipboard.';
      } catch {
        if (status) status.textContent = 'Copy failed. Select the commands manually.';
      }
    });
  });
</script>
