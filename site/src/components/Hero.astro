---
import TerminalFrame from './TerminalFrame.astro';
import { GITHUB_URL, LIMITATIONS_URL, QUICKSTART_URL } from '../config';
import heroExamples from '../data/hero-examples.json';
import processorReference from '../generated/processors-reference.json';

import { esc, hlShell, hlTs } from '../lib/highlight';

// Measured or catalog-backed facts; the storage figure is the externalized
// profile's evidence row in data/costs.json, footnoted there as workload-specific.
const stats = [
  ['1M blocks → 9.5 MB', 'externalized policy, real Mainnet run'],
  ['0 API keys', 'public Xatu datasets + Ethereum P2P'],
  [`${processorReference.processors.length} processors`, 'built in, or your own native Rust'],
  ['MIT-licensed', 'Rust library + standalone node'],
];

// Lines with a className keep their whole-line styling (dim context, accent
// payoffs); everything else gets language tokens.
const examples = heroExamples.map((example) => {
  const lines = example.lines;
  return {
  ...example,
  lines: lines.map((line) => ({
    ...line,
    className: 'className' in line ? line.className : undefined,
    html:
      line.text && !('className' in line && line.className)
        ? example.lang === 'ts'
          ? hlTs(line.text)
          : hlShell(line.text)
        : undefined,
  })),
  };
});
---
<section class="hero wrap section">
  <div class="hero-grid">
    <div class="hero-copy">
      <a class="eyebrow mono" href={LIMITATIONS_URL}>Public preview</a>
      <h1>Ethereum data, shaped for your application.</h1>
      <p class="sub">
        An Ethereum indexing node you run inside your own infra. Backfill from
        public datasets, follow the head over Ethereum P2P, and deterministically
        reduce blocks into only the state, outputs, and durable streams you
        choose to retain. Point viem or any JSON-RPC client at it, or stream
        changes over the SDK.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={QUICKSTART_URL}>Quickstart →</a>
        <a class="btn btn-ghost" href={GITHUB_URL}>GitHub ↗</a>
      </div>
    </div>

    <div class="hero-term">
      <div class="hero-tabs mono" role="tablist" aria-label="Hero examples">
        {examples.map((example, i) => (
          <button
            role="tab"
            id={`hero-tab-${example.id}`}
            aria-controls={`hero-panel-${example.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{example.label}</button>
        ))}
      </div>
      {examples.map((example) => (
        <div
          class="hero-panel"
          role="tabpanel"
          id={`hero-panel-${example.id}`}
          aria-labelledby={`hero-tab-${example.id}`}
        >
          <TerminalFrame title={example.title}>
            <div class="hero-transcript">
              {example.lines.map((l) => (
                <span class={`t-line ${l.className ?? ''}`} set:html={l.html ?? esc(l.text)} />
              ))}
            </div>
          </TerminalFrame>
          <p class="mono note">
            {example.note}
            {'noteHref' in example && (
              <a href={(example as { noteHref: string }).noteHref}>
                {(example as { noteLabel: string }).noteLabel}
              </a>
            )}
          </p>
        </div>
      ))}
    </div>
  </div>

  <ul class="stats mono" aria-label="Measured facts">
    {stats.map(([value, label]) => (
      <li><b>{value}</b><span>{label}</span></li>
    ))}
  </ul>
</section>

<style>
  .hero { padding-top: 3.5rem; }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  .hero-copy, .hero-term, .hero-panel { min-width: 0; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); max-width: 18ch; margin-top: 0.9rem; }
  .sub { color: var(--ink-dim); font-size: 1.15rem; max-width: 52ch; margin-top: 1.1rem; }
  .cta { display: flex; gap: 0.9rem; margin-top: 1.7rem; flex-wrap: wrap; }
  .hero-term { max-width: 54rem; }
  /* Wide screens: copy left, terminal right, so the product runs above the fold. */
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 11fr) minmax(0, 12fr); gap: 3rem; }
    h1 { font-size: clamp(2.3rem, 3.1vw, 2.9rem); max-width: 14ch; }
    .sub { font-size: 1.02rem; max-width: 42ch; }
    .hero-term { max-width: none; }
    .hero-term :global(.term-body) { font-size: 0.78rem; }
  }
  .stats {
    list-style: none; padding: 1.25rem 0 0; margin-top: 3rem;
    border-top: 1px solid var(--panel-edge);
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem;
  }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .stats { grid-template-columns: 1fr; } }
  .stats b { display: block; color: var(--accent); font-size: 0.95rem; }
  .stats span { display: block; color: var(--ink-dim); font-size: 0.76rem; margin-top: 0.15rem; }
  .hero-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .hero-tabs [role='tab'] {
    background: none; border: 1px solid var(--panel-edge); border-radius: 6px;
    color: var(--ink-dim); font: inherit; font-size: 0.8rem;
    padding: 0.35rem 0.8rem; cursor: pointer;
  }
  .hero-tabs [role='tab']:hover { color: var(--ink); border-color: var(--accent-dim); }
  .hero-tabs [role='tab'][aria-selected='true'] {
    color: var(--accent); border-color: var(--accent-dim);
  }
  .hero-panel { margin-top: 0; }
  .hero-panel + .hero-panel { margin-top: 1rem; }
  .note { color: var(--ink-dim); font-size: 0.7rem; margin-top: 0.5rem; }
</style>

<script>

  const tablist = document.querySelector<HTMLElement>('.hero-tabs');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.hero-tabs [role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.hero-panel')];
  function select(index: number, opts: { focus?: boolean } = {}) {
    tabs.forEach((tab, i) => {
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
      panels[i]!.hidden = i !== index;
    });
    if (opts.focus !== false) tabs[index]!.focus();
  }

  // Panels render visible for JS-off readers; JS collapses to tab view.
  select(0, { focus: false });

  tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
  tablist?.addEventListener('keydown', (e) => {
    const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    let next = current;
    if (e.key === 'ArrowRight') next = (current + 1) % tabs.length;
    if (e.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
    if (e.key === 'Home') next = 0;
    if (e.key === 'End') next = tabs.length - 1;
    if (next !== current) {
      e.preventDefault();
      select(next);
    }
  });
</script>
