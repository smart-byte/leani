<section id="pipeline" class="section" aria-labelledby="pipeline-h">
  <div id="pipeline-stage" class="wrap">
    <h2 id="pipeline-h"><span class="mono"># </span>Two lanes in. One processor contract.</h2>
    <p class="lede">
      Historical backfill and live head-following normalize into the same block
      envelope. Each source declares its capabilities and trust model; raw input
      can disappear after commit or remain under an explicit retention policy.
    </p>
    <svg
      viewBox="0 0 1200 760"
      role="img"
      aria-label="Diagram: historical sources (trusted Xatu datasets and commitment-checked EraE archives) and live sources (Ethereum P2P and consensus finality) flow through capability-aware source adapters into normalized block envelopes, then validation and canonicality, then a parallel per-block map and ordered reduce, ending in policy-shaped SQLite state and durable delivery. Raw bytes are discarded unless retention is enabled."
      class="mono"
    >
      <defs>
        <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" fill="var(--accent-dim)" />
        </marker>
      </defs>

      <!-- Lane: historical -->
      <g id="lane-hist">
        <text x="60" y="52" class="lane-label">HISTORICAL LANE</text>
        <g class="chip"><rect x="60" y="70" width="200" height="44" rx="8"/><text x="160" y="97">Xatu · trusted dataset</text></g>
        <g class="chip"><rect x="60" y="126" width="200" height="44" rx="8"/><text x="160" y="153">EraE · checked archive</text></g>
        <g class="chip"><rect x="60" y="182" width="200" height="44" rx="8"/><text x="160" y="209">retained raw segments</text></g>
        <path class="wire" d="M260 148 H 420" marker-end="url(#arr)"/>
      </g>

      <!-- Lane: live -->
      <g id="lane-live">
        <text x="940" y="52" class="lane-label" text-anchor="end">LIVE LANE</text>
        <g class="chip"><rect x="940" y="70" width="200" height="44" rx="8"/><text x="1040" y="97">Ethereum P2P</text></g>
        <g class="chip"><rect x="940" y="126" width="200" height="44" rx="8"/><text x="1040" y="153">CL finality (verified)</text></g>
        <path class="wire" d="M940 148 H 780" marker-end="url(#arr)"/>
      </g>

      <!-- Stages, vertically stacked center -->
      <g id="stage-adapters" class="stage"><rect x="420" y="110" width="360" height="58" rx="8"/><text x="600" y="145">capability-aware source adapters</text></g>
      <path class="wire" d="M600 168 V 208" marker-end="url(#arr)"/>
      <g id="stage-normalize" class="stage"><rect x="420" y="210" width="360" height="58" rx="8"/><text x="600" y="245">normalized BlockEnvelope</text></g>
      <path class="wire" d="M600 268 V 308" marker-end="url(#arr)"/>
      <g id="stage-validate" class="stage"><rect x="420" y="310" width="360" height="58" rx="8"/><text x="600" y="345">validation + canonicality + provenance</text></g>
      <path class="wire" d="M600 368 V 408" marker-end="url(#arr)"/>
      <g id="stage-mapreduce" class="stage"><rect x="420" y="410" width="360" height="58" rx="8"/><text x="600" y="445">parallel map → ordered reduce</text></g>
      <path class="wire" d="M600 468 V 508" marker-end="url(#arr)"/>
      <g id="stage-store" class="stage store"><rect x="440" y="510" width="320" height="58" rx="8"/><text x="600" y="545">policy-shaped state + delivery</text></g>

      <!-- Discarded bytes, drifting right of mapreduce -->
      <g id="discard">
        <text x="830" y="430" class="discard-label">raw bytes optional ✕</text>
        <rect class="byte" x="800" y="440" width="10" height="10"/>
        <rect class="byte" x="820" y="452" width="8" height="8"/>
        <rect class="byte" x="838" y="444" width="6" height="6"/>
        <rect class="byte" x="852" y="456" width="9" height="9"/>
      </g>

      <!-- Moving block glyphs: CSS-animated along the wires; static markers under reduced motion -->
      <g id="flow-blocks">
        <rect class="blk blk-hist" x="270" y="140" width="16" height="16" rx="3"/>
        <rect class="blk blk-live" x="900" y="140" width="16" height="16" rx="3"/>
        <rect class="blk blk-spine" x="592" y="160" width="16" height="16" rx="3"/>
        <rect class="blk blk-spine blk-spine-2" x="592" y="160" width="16" height="16" rx="3"/>
      </g>

      <!-- Storage equation -->
      <g id="equation">
        <text x="600" y="640" class="eq" text-anchor="middle">disk = the lifecycle policies you select</text>
        <text x="600" y="676" class="eq eq-dim" text-anchor="middle">state · output · delivery · artifacts · checkpoints · undo · raw</text>
      </g>
    </svg>
  </div>
</section>

<style>
  #pipeline { background: color-mix(in srgb, var(--panel) 55%, var(--bg)); border-block: 1px solid var(--panel-edge); }
  .lede { color: var(--ink-dim); max-width: 52ch; margin-top: 1rem; }
  svg { width: 100%; height: auto; margin-top: 3rem; display: block; }
  .lane-label { fill: var(--ink-dim); font-size: 13px; letter-spacing: 0.15em; }
  .chip rect, .stage rect { fill: var(--panel); stroke: var(--panel-edge); }
  .chip text, .stage text { fill: var(--ink); font-size: 15px; text-anchor: middle; }
  .stage.store rect { stroke: var(--accent); }
  .stage.store text { fill: var(--accent); }
  .wire { stroke: var(--accent-dim); stroke-width: 1.5; fill: none; }
  .discard-label { fill: var(--ink-dim); font-size: 13px; text-anchor: middle; }
  .byte { fill: var(--ink-dim); }
  .blk { fill: var(--accent); }
  .eq { fill: var(--ink); font-size: 22px; }
  .eq-dim { fill: var(--ink-dim); font-size: 18px; }

  /* Ambient data-flow animation. Pure CSS: runs without JS, and the
     reduced-motion gate leaves the diagram fully static. */
  @media (prefers-reduced-motion: no-preference) {
    .wire {
      stroke-dasharray: 5 7;
      animation: flow 1.1s linear infinite;
    }
    @keyframes flow { to { stroke-dashoffset: -12; } }

    /* Lane blocks arrive raw (grey); the spine transforms them stage by stage. */
    .blk-hist, .blk-live { fill: var(--ink-dim); }

    .blk-hist { animation: lane-hist 2.8s linear infinite; }
    @keyframes lane-hist {
      0% { transform: translateX(0); opacity: 0; }
      12% { opacity: 1; }
      82% { opacity: 1; }
      100% { transform: translateX(140px); opacity: 0; }
    }

    .blk-live { animation: lane-live 2.8s linear 1.4s infinite; opacity: 0; }
    @keyframes lane-live {
      0% { transform: translateX(0); opacity: 0; }
      12% { opacity: 1; }
      82% { opacity: 1; }
      100% { transform: translateX(-130px); opacity: 0; }
    }

    .blk-spine {
      animation: spine 4.6s linear infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    .blk-spine-2 { animation-delay: 2.3s; opacity: 0; }
    /* translateY stays proportional to the percentage (3.4px per 1%) so speed is
       constant; fill snaps right after each stage box: raw grey -> normalized
       envelope -> validated -> reduced accent, absorbed at the store's top edge. */
    @keyframes spine {
      0%   { transform: translateY(0); opacity: 0; fill: #8fa89a; }
      6%   { opacity: 1; }
      20%  { transform: translateY(68px) scale(1); fill: #8fa89a; }
      22%  { transform: translateY(74.8px) scale(1.35); fill: #e6f0ea; }
      24%  { transform: translateY(81.6px) scale(1); }
      50%  { transform: translateY(170px) scale(1); fill: #e6f0ea; }
      52%  { transform: translateY(176.8px) scale(1.35); fill: #9ff0c4; }
      54%  { transform: translateY(183.6px) scale(1); }
      80%  { transform: translateY(272px) scale(1); fill: #9ff0c4; }
      82%  { transform: translateY(278.8px) scale(1.35); fill: #3ee07f; }
      84%  { transform: translateY(285.6px) scale(1); }
      92%  { transform: translateY(312.8px) scale(1); opacity: 1; fill: #3ee07f; }
      100% { transform: translateY(340px) scale(0.5); opacity: 0; fill: #3ee07f; }
    }

    .byte { animation: dissolve 2.4s ease-in infinite; }
    .byte:nth-of-type(2) { animation-delay: 0.6s; }
    .byte:nth-of-type(3) { animation-delay: 1.2s; }
    .byte:nth-of-type(4) { animation-delay: 1.8s; }
    @keyframes dissolve {
      0% { transform: translateY(0); opacity: 1; }
      70% { opacity: 0.25; }
      100% { transform: translateY(44px); opacity: 0; }
    }
  }
</style>
