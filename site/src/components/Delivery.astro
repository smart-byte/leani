<script>
  // The seam's timeline loads only once the section nears the viewport.
  const chart = document.querySelector<HTMLElement>('#delivery [data-seam]');
  if (chart && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      io.disconnect();
      void import('../lib/seam').then(({ startSeam }) => startSeam(chart));
    }, { rootMargin: '300px 0px' });
    io.observe(chart);
  }
</script>
