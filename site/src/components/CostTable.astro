---
import costs from '../data/costs.json';

const columns = [
  ['retains', 'Retained by leani'],
  ['bound', 'Bound'],
  ['fit', 'Best fit'],
  ['evidence', 'Example'],
] as const;
---
<div class="policies not-content">
  <table>
    <thead>
      <tr>
        <th scope="col">Policy</th>
        {columns.map(([, label]) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {costs.rows.map((row) => (
        <tr class={row.highlight ? 'hl' : ''}>
          <th scope="row" class="mono">{row.profile}</th>
          {columns.map(([key, label]) => <td data-label={label}>{row[key]}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
  <ol class="footnotes">
    {costs.footnotes.map((note) => <li>{note}</li>)}
  </ol>
</div>

<style>
  .policies { container-type: inline-size; }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.9rem 1rem; border-bottom: 1px solid var(--panel-edge); vertical-align: top; }
  thead th { color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 400; }
  tbody th { font-weight: 400; }
  tr.hl { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  tr.hl th { color: var(--accent); }
  /* Too narrow for five columns: one block per policy, each cell labelled. */
  @container (max-width: 56rem) {
    table, tbody, tr, th, td { display: block; }
    thead { display: none; }
    tr { padding: 0.9rem 0.75rem; border-bottom: 1px solid var(--panel-edge); }
    tbody th, td { padding: 0.15rem 0; border: 0; }
    tbody th { padding-bottom: 0.4rem; }
    td::before { content: attr(data-label) ': '; color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.8rem; }
  }
  .footnotes { color: var(--ink-dim); font-size: 0.8rem; margin-top: 1.5rem; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
</style>
