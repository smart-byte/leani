---
import buildMetadata from '../generated/build-metadata.json';
import { GITHUB_URL, HOMEBREW_STABLE_INSTALL, STABLE_RELEASE_URL } from '../config';
---

{
  buildMetadata.releaseCandidate && (
    <aside class="release-candidate" data-pagefind-ignore>
      This site shows the release candidate{' '}
      <a href={`${GITHUB_URL}/releases/tag/${buildMetadata.docsRef}`}>leani {buildMetadata.docsRef.slice(1)}</a>. For
      the stable release, use <code>{HOMEBREW_STABLE_INSTALL}</code> or <a href={STABLE_RELEASE_URL}>GitHub</a>.
    </aside>
  )
}

<style>
  /* Starlight's colors on docs pages, the site's own elsewhere. */
  .release-candidate {
    background: color-mix(in srgb, var(--sl-color-accent, var(--accent)) 16%, var(--sl-color-bg, var(--bg)));
    border-block-end: 1px solid var(--accent-dim);
    color: var(--sl-color-text, var(--ink));
    font-size: 0.875rem;
    line-height: 1.5;
    padding: 0.55rem 1rem;
    text-align: center;
  }

  a {
    color: var(--sl-color-text-accent, var(--accent));
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    white-space: nowrap;
  }
</style>
