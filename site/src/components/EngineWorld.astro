---
import { pipelineProcessors } from '../data/pipeline';

// The block engine's geometry and motion. Parents own the camera and the
// orientation, and pause it by setting data-running="false" on an ancestor.
interface Props {
  // Prefixes SVG ids so more than one engine can share a page.
  idPrefix: string;
  // Stage that renders highlighted before any script runs.
  active?: string;
}
const { idPrefix, active } = Astro.props;
const railGradient = `${idPrefix}-rail-gradient`;
const inputLanes = ['history', 'live'];
const sharedLayers = [
  { name: 'Validation', level: 116, id: 'validate', number: '02' },
  { name: 'Block envelope', level: 168, id: 'normalize', number: '01' },
];
const processorLayers = [
  { name: 'reduce()', level: 36, id: 'reduce' },
  { name: 'map()', level: 66, id: 'map' },
];
---
<div class="world">
  <div class="floor"></div>
  <div class="floor-cross cross-a"></div><div class="floor-cross cross-b"></div><div class="floor-cross cross-c"></div><div class="floor-cross cross-d"></div>
  <svg class="rails" viewBox="0 0 860 480" fill="none">
    <defs><linearGradient id={railGradient}><stop stop-color="#466b58"/><stop offset="1" stop-color="#3ee07f"/></linearGradient></defs>
    <g class="rail-bed"><path d="M110 100H218Q250 100 250 132V208Q250 240 282 240H430"/><path d="M110 380H218Q250 380 250 348V272Q250 240 282 240H430"/><path d="M430 240H755"/></g>
    <g class="rail-line" stroke={`url(#${railGradient})`}><path d="M110 100H218Q250 100 250 132V208Q250 240 282 240H430"/><path d="M110 380H218Q250 380 250 348V272Q250 240 282 240H430"/><path d="M430 240H755"/></g>
    <g class="rail-ticks"><path d="M110 100H218Q250 100 250 132V208Q250 240 282 240H430"/><path d="M110 380H218Q250 380 250 348V272Q250 240 282 240H430"/><path d="M430 240H755"/></g>
  </svg>
  <div class="source archive">
    {[0, 1, 2, 3].map((level) => <div class="archive-slab" style={`--level: ${level}`}><span></span><span></span><span></span></div>)}
    <div class="source-caption mono">HISTORY</div>
  </div>
  <div class="source live-source">
    <div class="emitter-base"><div class="emitter-rings"></div></div>
    <div class="emitter-signal signal-one"></div><div class="emitter-signal signal-two"></div>
    <div class="live-gem"><div class="gem-top"></div><div class="gem-bottom"></div></div>
    <div class="source-caption mono">LIVE HEAD</div>
  </div>
  {inputLanes.map((lane) => [0, 1, 2].map((index) => (
    <div class={`packet packet-${lane}`} style={`--delay: ${-index * 2 - (lane === 'live' ? 1 : 0)}s; --position: ${18 + index * 28 - (lane === 'live' ? 14 : 0)}%`}>
      <div class="cube"></div>
    </div>
  )))}
  <div class="handoff-gate"></div>
  <div class="handoff-label mono">exact handoff</div>
  {pipelineProcessors.map((processor, index) => (
    <div class="packet packet-output" style={`--slot: ${index}; --position: ${20 + index * 20}%; --processor-color: ${processor.color}`}>
      <div class="cube"></div>
    </div>
  ))}
  <div class="processor">
    <div class="processor-foundation"><span class="mono">leani_</span><div class="pins pins-left"></div><div class="pins pins-right"></div></div>
    {processorLayers.map(({ name, level, id }) => (
      <div class:list={['processor-layer', 'split-layer', id, { 'is-active': id === active }]} data-stage-target={id} style={`--height: ${level}px; --layer: ${id === 'map' ? 1 : 0}`}>
        {pipelineProcessors.map((processor, index) => (
          <div class="processor-module" data-processor-target={processor.id} style={`--col: ${index % 2}; --row: ${Math.floor(index / 2)}; --processor-color: ${processor.color}; --module: ${index}`}>
            <div class="module-edge"></div>
            <div class="module-surface">
              <span class="module-title mono">{processor.short}</span>
              <span class="module-method mono">{name}</span>
              <i class="module-led"></i>
            </div>
          </div>
        ))}
      </div>
    ))}
    {sharedLayers.map(({ name, level, id, number }, index) => (
      <div class:list={['processor-layer', id, { 'is-active': id === active }]} data-stage-target={id} style={`--height: ${level}px; --layer: ${index + 2}`}>
        <div class="plate-edge edge-front"></div><div class="plate-edge edge-right"></div>
        <div class="plate-surface">
          <span class="plate-number mono">{number}</span>
          <div class="plate-circuit"><span></span><span></span><span></span><span></span></div>
          <span class="plate-name mono">{name}</span><i class="plate-led"></i>
        </div>
      </div>
    ))}
    <div class="intake-ring"></div>
  </div>
  <div class:list={['state-bank', { 'is-active': active === 'store' }]} data-stage-target="store">
    <div class="state-base"><span class="mono">COMMITTED STATE</span></div>
    {Array.from({ length: 9 }, (_, index) => (
      <div class="state-cell" style={`--col: ${index % 3}; --row: ${Math.floor(index / 3)}; --cell: ${index}`}>
        <div class="cube"></div>
      </div>
    ))}
  </div>
  <div class="raw-path mono"><span>raw bytes</span><span>optional after commit</span></div>
  {[0, 1, 2, 3].map((index) => <div class="raw-fragment" style={`--fragment: ${index}`}></div>)}
</div>

<style>
  /* One beat per second: a block reaches the core, its output leaves
     --process later, and lands --output-travel after that, committing one
     state cell. Inputs run a 6s loop of 6 blocks, outputs a 4s loop of one
     block per processor, state cells a 9s loop of 9 cells. */
  .world { --process: 0.4s; width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
  :global([data-running='false']) .world *, :global([data-running='false']) .world *::before, :global([data-running='false']) .world *::after { animation-play-state: paused !important; }
  /* Only 3D groups preserve depth. SVG rails and plate artwork stay flat
     within their own plane so their children paint consistently across engines. */
  .source, .packet, .cube, .processor, .processor-layer, .processor-module, .state-bank, .state-cell { transform-style: preserve-3d; }
  .floor, .floor-cross, .rails, .packet, .emitter-signal, .intake-ring, .raw-fragment { pointer-events: none; }
  .floor { position: absolute; inset: -65px -40px; background-image: linear-gradient(#35533f26 1px, transparent 1px), linear-gradient(90deg, #35533f26 1px, transparent 1px); background-size: 32px 32px; border: 1px solid #35533f26; mask-image: radial-gradient(ellipse, black 30%, transparent 72%); }
  .floor-cross { position: absolute; width: 12px; height: 12px; }
  .floor-cross::before, .floor-cross::after { content: ''; position: absolute; background: #52765c66; }
  .floor-cross::before { width: 12px; height: 1px; top: 6px; }
  .floor-cross::after { width: 1px; height: 12px; left: 6px; }
  .cross-a { left: 15px; top: 20px; }.cross-b { right: 15px; top: 20px; }.cross-c { left: 15px; bottom: 10px; }.cross-d { right: 15px; bottom: 10px; }
  .rails { position: absolute; inset: 0; width: 860px; height: 480px; overflow: visible; transform: translateZ(2px); }
  .rail-bed { stroke: #142c1e; stroke-width: 28px; }
  .rail-line { stroke-width: 1px; }
  .rail-ticks { stroke: #74c28e; stroke-width: 16px; stroke-dasharray: 1 15; opacity: 0.3; }
  .source { position: absolute; width: 112px; height: 112px; left: 54px; }
  .archive { top: 44px; }
  .archive-slab { position: absolute; inset: 0; border: 1px solid #69987b; border-radius: 5px; background: linear-gradient(135deg, #294435, #17271e); transform: translateZ(calc(8px + var(--level) * 16px)); box-shadow: 0 5px 0 #102218, 0 6px 0 #3e614b; display: flex; flex-direction: column; justify-content: center; gap: 9px; padding: 22px; }
  .archive-slab span { height: 4px; background: repeating-linear-gradient(90deg, #7c9d88 0 14px, transparent 14px 19px); opacity: 0.7; }
  .archive-slab span:nth-child(2) { width: 75%; }
  .source-caption { position: absolute; top: 124px; width: 100%; text-align: center; font-size: 14px; letter-spacing: 0.07em; color: #c1d9c9; }
  .live-source { top: 324px; }
  .emitter-base { position: absolute; inset: 0; border: 1px solid #409761; background: #102d1c; border-radius: 8px; transform: translateZ(8px); box-shadow: 0 6px 0 #112519, 0 7px 0 #315e41; }
  .emitter-rings { position: absolute; inset: 15px; border: 1px solid #3ee07f55; border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 11px, #3ee07f44 12px 13px, transparent 14px 24px); }
  .emitter-signal { position: absolute; inset: 20px; border: 1px solid #3ee07f88; border-radius: 50%; transform: translateZ(20px); animation: broadcast 4s ease-out infinite; }
  /* Live blocks spawn at t = 1, 3, 5s; each ring fires as one leaves the emitter. */
  .signal-one { animation-delay: -3s; }
  .signal-two { animation-delay: -1s; }
  .live-gem { position: absolute; width: 28px; height: 40px; left: 42px; top: 36px; transform: translateZ(42px) rotateZ(30deg) rotateX(-55deg); }
  .gem-top { width: 28px; height: 27px; background: linear-gradient(90deg, #91ffb9 50%, #3d9c63 50%); clip-path: polygon(50% 0, 100% 76%, 50% 100%, 0 76%); }
  .gem-bottom { width: 28px; height: 14px; margin-top: -2px; background: linear-gradient(90deg, #59c883 50%, #246b40 50%); clip-path: polygon(0 0, 50% 35%, 100% 0, 50% 100%); }
  /* Opacity animation on a 3D parent flattens its faces, even at opacity: 1.
     Keep packets solid; their paths start and end inside the source/core/state.
     Packets float just above the source pads (z 8) and stay below the lowest
     processor layer, so they neither cut into a pad nor through the modules. */
  .packet { position: absolute; left: 0; top: 0; width: 18px; height: 18px; offset-rotate: 0deg; offset-distance: var(--position); transform: translateZ(18px); animation: travel 6s linear infinite; animation-delay: var(--delay); }
  .packet-history { --cube-top: #b4d4bf; --cube-front: #537660; --cube-side: #385842; offset-path: path('M110 100H218Q250 100 250 132V208Q250 240 282 240H430'); }
  .packet-live { --cube-top: #91ffb9; --cube-front: #37b86b; --cube-side: #22763e; offset-path: path('M110 380H218Q250 380 250 348V272Q250 240 282 240H430'); }
  .packet-output { --cube-top: var(--processor-color); --cube-front: color-mix(in srgb, var(--processor-color) 62%, #0b110e); --cube-side: color-mix(in srgb, var(--processor-color) 42%, #0b110e); width: 10px; height: 10px; transform: translateZ(12px); offset-path: path('M475 240H700'); animation-name: deliver; animation-duration: 4s; animation-delay: calc(var(--process) + var(--slot) * 1s - 4s); }
  .packet-output .cube { --size: 10px; }
  /* Scale the cube, not the packet: the packet's scale would also scale its motion-path offset. */
  .packet .cube { animation: spawn 6s linear infinite; animation-delay: var(--delay); }
  .packet-output .cube { animation: absorb 4s linear infinite; animation-delay: calc(var(--process) + var(--slot) * 1s - 4s); }
  /* Blocks from both lanes pass the junction about 2.1s before they reach the core. */
  .handoff-gate { position: absolute; left: 275px; top: 233px; width: 14px; height: 14px; border: 1px solid #9dffc0; border-radius: 3px; transform: translateZ(3px) rotate(45deg); opacity: 0.25; animation: handoff 1s ease-out infinite; animation-delay: -0.1s; pointer-events: none; }
  .handoff-label { position: absolute; left: 118px; top: 232px; transform: translateZ(1px); font-size: 13px; letter-spacing: 0.04em; color: #a7c0af; pointer-events: none; }
  /* Three visible faces, with sides generated in CSS to keep the diagram lean. */
  .cube { --size: 18px; width: var(--size); height: var(--size); position: relative; background: var(--cube-top); border: 1px solid #bcffd35e; transform: translateZ(calc(var(--size) / 2)); }
  .cube::before, .cube::after { content: ''; position: absolute; inset: -1px; border: 1px solid #bcffd35e; backface-visibility: hidden; }
  .cube::before { background: var(--cube-front); transform: translateY(calc(var(--size) / 2)) translateZ(calc(var(--size) / -2)) rotateX(-90deg); }
  .cube::after { background: var(--cube-side); transform: translateX(calc(var(--size) / -2)) translateZ(calc(var(--size) / -2)) rotateY(-90deg); }
  .processor { position: absolute; left: 308px; top: 148px; width: 244px; height: 184px; }
  .processor-foundation { position: absolute; inset: -14px -26px -46px; background: #13291b; border: 1px solid #3e7752; border-radius: 8px; box-shadow: 0 8px 0 #0d1c12, 0 9px 0 #31543d, 0 24px 45px #0009; }
  .processor-foundation, .processor-layer, .intake-ring { scale: 0.96; }
  .processor-foundation > span { position: absolute; bottom: 8px; right: 10px; color: #daf5e4; font-size: 17px; font-weight: 700; line-height: 1; }
  .pins { position: absolute; top: 22px; bottom: 22px; width: 10px; background: repeating-linear-gradient(0deg, #6b9578 0 3px, transparent 3px 10px); }
  .pins-left { left: -10px; }.pins-right { right: -10px; }
  .processor-layer { position: absolute; inset: 0; transform: translateZ(var(--height)); animation: layer-breathe 6s ease-in-out infinite; }
  .plate-surface { position: absolute; inset: 0; border: 1px solid #6aaa80; border-radius: 5px; background: linear-gradient(145deg, #243f2edb, #102219f2); }
  .normalize .plate-surface::after { content: ''; position: absolute; inset: -1px; border: 1px solid #c4ffd9; border-radius: inherit; box-shadow: 0 0 24px #3ee07f66, inset 0 0 22px #3ee07f26; opacity: 0; animation: arrive 1s ease-out infinite; pointer-events: none; }
  .normalize .plate-surface { border-color: #85e9a6; background: linear-gradient(145deg, #33543fdc, #193723ed); box-shadow: 0 0 30px #3ee07f14, inset 0 0 25px #3ee07f10; }
  .plate-edge { position: absolute; background: #142c1d; border: 1px solid #416e50; }
  .edge-front { width: 244px; height: 8px; top: 184px; transform-origin: top; transform: rotateX(-90deg); }
  .edge-right { width: 8px; height: 184px; left: 244px; transform-origin: left; transform: rotateY(90deg); }
  .plate-number { position: absolute; left: 12px; top: 8px; color: #c0dcca; font-size: 13px; }
  .plate-name { position: absolute; bottom: 14px; left: 16px; color: #effff4; font-size: 18px; font-weight: 700; }
  .plate-led { position: absolute; top: 13px; right: 13px; width: 4px; height: 4px; border-radius: 50%; background: #8dffb5; box-shadow: 0 0 8px #3ee07f; }
  .plate-circuit { position: absolute; inset: 35px 76px 52px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; border: 1px solid #69a37c77; padding: 7px; }
  .plate-circuit::before, .plate-circuit::after { content: ''; position: absolute; width: 19px; height: 38px; top: 20px; background: repeating-linear-gradient(0deg, #7ac28e77 0 1px, transparent 1px 7px); }
  .plate-circuit::before { right: 100%; }.plate-circuit::after { left: 100%; }
  .plate-circuit span { border: 1px solid #a2e7b975; background: #3ee07f18; animation: compute 3s ease-in-out infinite; animation-delay: calc(var(--layer) * -0.65s); }
  .plate-circuit span:nth-child(2n) { animation-delay: calc(var(--layer) * -0.65s - 1.5s); }
  .intake-ring { position: absolute; inset: -6px; border: 1px solid #8bffb677; border-radius: 6px; transform: translateZ(178px); animation: intake 6s ease-out infinite; }
  .state-bank { position: absolute; left: 686px; top: 173px; width: 138px; height: 138px; }
  .state-base { position: absolute; inset: -8px; border: 1px solid #4ca66a; border-radius: 6px; background: #142e1e; transform: translateZ(5px); box-shadow: 0 6px 0 #102319, 0 7px 0 #365c43; }
  .state-base > span { position: absolute; bottom: -28px; width: 100%; text-align: center; color: #b9dcc4; font-size: 13px; letter-spacing: 0.07em; }
  .state-cell { --cube-top: #78e99c; --cube-front: #36a55d; --cube-side: #206a3b; position: absolute; left: calc(8px + var(--col) * 43px); top: calc(8px + var(--row) * 43px); transform: translateZ(27px); animation: commit 9s ease-out infinite; animation-delay: calc(var(--process) + var(--cell) * 1s - 9.3s); }
  .state-cell .cube { --size: 35px; }
  .raw-path { position: absolute; left: 505px; top: 375px; border-left: 1px dashed #53705d; padding: 12px; transform: translateZ(1px); font-size: 13px; color: #a7c0af; }
  .raw-path span { display: block; }
  .raw-fragment { position: absolute; left: calc(480px + var(--fragment) * 20px); top: calc(310px + var(--fragment) * 13px); width: 7px; height: 7px; background: #73907d; transform: translateZ(25px); animation: discard 4s ease-out infinite; animation-delay: calc(var(--fragment) * -1s); }
  .processor-module { position: absolute; left: calc(var(--col) * 154px - 12px); top: calc(var(--row) * 100px + 30px); width: 114px; height: 84px; }
  .module-surface { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, var(--processor-color) 60%, #1b3021); border-radius: 5px; background: #17271e; transition: border-color 180ms, background 180ms, box-shadow 180ms; }
  .module-edge { position: absolute; width: 114px; height: 7px; top: 84px; transform-origin: top; transform: rotateX(-90deg); background: #183224; border: 1px solid color-mix(in srgb, var(--processor-color) 50%, #1b3021); }
  .module-title { display: block; position: absolute; left: 10px; top: 8px; font-size: 17px; font-weight: 700; color: var(--processor-color); }
  .module-method { position: absolute; left: 10px; bottom: 9px; font-size: 14px; color: #e8f9ee; }
  /* The map() module above covers each reduce() title, leaving only clipped letters; its name already labels the stack. */
  .reduce .module-title { visibility: hidden; }
  .module-led { position: absolute; right: 10px; bottom: 16px; width: 5px; height: 5px; background: var(--processor-color); box-shadow: 0 0 9px var(--processor-color); animation: compute 3s ease-in-out infinite; animation-delay: calc(var(--module) * -0.7s); }
  .map .processor-module::after { content: ''; position: absolute; left: 56px; top: 42px; width: 1px; height: 40px; transform-origin: top; transform: rotateX(-90deg); background: color-mix(in srgb, var(--processor-color) 50%, transparent); pointer-events: none; }
  .map .processor-module::before { content: ''; position: absolute; left: 53px; top: 39px; width: 7px; height: 7px; background: var(--processor-color); transform: translateZ(-20px); animation: delta-pass 3.2s linear infinite; animation-delay: calc(var(--module) * -0.8s); pointer-events: none; }
  .plate-surface { transition: border-color 180ms, box-shadow 180ms; }
  .is-active > .plate-surface { border-color: #c0ffd7; box-shadow: 0 0 26px #3ee07f45, inset 0 0 32px #3ee07f18; }
  .is-active .module-surface { border-color: var(--processor-color); background: color-mix(in srgb, var(--processor-color) 12%, #14221a); box-shadow: 0 0 20px color-mix(in srgb, var(--processor-color) 12%, transparent); }
  .processor-module.is-selected .module-surface { border: 2px solid var(--processor-color); background: color-mix(in srgb, var(--processor-color) 23%, #14221a); box-shadow: 0 0 23px color-mix(in srgb, var(--processor-color) 30%, transparent); }
  .state-bank.is-active .state-base { border-color: #baffd2; box-shadow: 0 0 32px #3ee07f55; }
  [data-stage-target] { cursor: pointer; }
  @keyframes travel { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes deliver { 0% { offset-distance: 0%; } 80% { offset-distance: 90%; } 100% { offset-distance: 100%; } }
  /* Blocks grow out of their source and outputs shrink into the state bank.
     Scale and translate keep the cube 3D, where opacity would flatten it. */
  @keyframes spawn { 0% { scale: 0; translate: 0 0 -10px; } 4% { scale: 0.65; } 10% { scale: 1; translate: 0 0 0; } }
  @keyframes absorb { 0%, 80% { scale: 1; translate: 0 0 0; } 92% { scale: 0.5; } 100% { scale: 0; translate: 0 0 -8px; } }
  @keyframes layer-breathe { 0%, 100% { transform: translateZ(var(--height)); } 50% { transform: translateZ(calc(var(--height) + var(--layer) * 4px + 3px)); } }
  @keyframes compute { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  @keyframes delta-pass { 0% { transform: translateZ(-5px); opacity: 0; } 15%, 85% { opacity: 1; } 100% { transform: translateZ(-36px); opacity: 0; } }
  @keyframes intake { 0%, 100% { opacity: 0; transform: translateZ(178px) scale(1); } 20% { opacity: 0.8; } 65% { opacity: 0; transform: translateZ(200px) scale(1.15); } }
  @keyframes broadcast { 0% { transform: translateZ(12px) scale(0.65); opacity: 0; } 15% { opacity: 0.8; } 100% { transform: translateZ(80px) scale(1.4); opacity: 0; } }
  @keyframes commit { 0%, 18%, 100% { transform: translateZ(27px); } 6% { transform: translateZ(44px); } 13% { transform: translateZ(25px); } }
  @keyframes arrive { 0% { opacity: 0.85; } 55%, 100% { opacity: 0; } }
  @keyframes handoff { 0% { opacity: 1; box-shadow: 0 0 12px #3ee07f; } 60%, 100% { opacity: 0.25; box-shadow: none; } }
  @keyframes discard { 0% { transform: translate3d(0, 0, 28px); opacity: 0; } 15% { opacity: 0.65; } 100% { transform: translate3d(45px, 65px, 1px) scale(0.2); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .plate-surface, .module-surface { transition: none; }
    .world *, .world *::before, .world *::after { animation: none !important; }
    .emitter-signal, .intake-ring, .raw-fragment, .normalize .plate-surface::after { display: none; }
  }
</style>
