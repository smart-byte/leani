<div class="rpc-subset not-content">
  <div class="grid">
    <div class="panel">
      <h3 class="mono ok-h">implemented exactly, when available</h3>
      <ul class="mono list">
        <li>eth_getBlockByNumber / ByHash</li>
        <li>eth_getBlockTransactionCountByNumber / ByHash</li>
        <li>eth_getTransactionByBlockNumberAndIndex / ByHashAndIndex</li>
        <li>eth_getTransactionByHash / Receipt</li>
        <li>eth_getBlockReceipts</li>
        <li>eth_getLogs <span class="note">(recent, on-demand, or materialized)</span></li>
        <li>eth_blockNumber · eth_chainId · eth_config · eth_syncing</li>
        <li>web3_clientVersion · net_version</li>
        <li>leani_getCapabilities</li>
        <li>eth_subscribe: newHeads, logs <span class="note">(reorg-correct)</span></li>
      </ul>
    </div>
    <div class="panel">
      <h3 class="mono no-h">refused, explicitly</h3>
      <ul class="mono list dead">
        <li>eth_call · eth_estimateGas</li>
        <li>eth_getBalance · eth_getTransactionCount</li>
        <li>eth_getCode · eth_getStorageAt</li>
        <li>debug/trace methods</li>
      </ul>
    </div>
  </div>
</div>

<style>
  .rpc-subset { container-type: inline-size; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  @container (max-width: 46rem) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .panel { min-width: 0; background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 10px; padding: 1.5rem; }
  .panel:first-child { border-color: var(--accent-dim); }
  h3 { font-size: 0.85rem; font-weight: 700; }
  .ok-h { color: var(--accent); }
  .no-h { color: var(--ink-dim); }
  .list { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.55rem; font-size: 0.88rem; }
  .list li { overflow-wrap: anywhere; }
  .list li::before { content: '▸ '; color: var(--accent-dim); }
  .dead li { text-decoration: line-through; text-decoration-color: var(--accent-dim); color: var(--ink-dim); }
  .dead li::before { content: '✕ '; text-decoration: none; }
  .note { color: var(--ink-dim); font-size: 0.8em; }
