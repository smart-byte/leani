---
import Wordmark from './Wordmark.astro';
import { COMPANY, GITHUB_URL, LEGAL_NOTICE_URL, PRIVACY_URL, sourceUrl } from '../config';
---
<footer class="wrap">
  <p class="tag mono"><Wordmark height={18} /><span>— the lean Ethereum indexing node</span></p>
  <nav aria-label="Footer">
    <a href="/docs">Docs</a>
    <a href="/docs/getting-started/">Getting started</a>
    <a href="/docs/reference/sdk/">SDK</a>
    <a href="/llms.txt">llms.txt</a>
    <a href={GITHUB_URL} data-umami-event="outbound" data-umami-event-place="footer" data-umami-event-to="github">GitHub</a>
  </nav>
  <p class="fine">
    <a href={sourceUrl('LICENSE')}>MIT-licensed</a> ·{' '}
    <a href={sourceUrl('THIRD_PARTY_LICENSES.txt')}>third-party notices</a> ·
    built by <a href={COMPANY.url}>Smart-Byte</a> · historical demo data:{' '}
    <a href="https://github.com/ethpandaops/xatu-data">Xatu by ethPandaOps</a> (CC BY 4.0)
  </p>
  <p class="fine">
    <a href={LEGAL_NOTICE_URL}>Legal notice (Impressum)</a> · <a href={PRIVACY_URL}>Privacy</a>
  </p>
</footer>

<style>
  footer { padding-block: 3.5rem; border-top: 1px solid var(--panel-edge); display: grid; gap: 0.9rem; }
  .tag { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; }
  nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .fine { color: var(--ink-dim); font-size: 0.8rem; }
</style>
