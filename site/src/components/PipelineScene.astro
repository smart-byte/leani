---
import EngineWorld from './EngineWorld.astro';
import { pipelineStages, pipelineProcessors } from '../data/pipeline';
const initialStage = pipelineStages[2];
---
<pipeline-scene class="engine" data-running="false">
  <div class="engine-bar mono">
    <span><span class="status-dot"></span> THE BLOCK ENGINE</span>
    <button class="motion-toggle" type="button" aria-label="Pause pipeline animation" aria-pressed="false" hidden>
      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path class="pause-icon" d="M4 2v8M8 2v8"/><path class="play-icon" d="m4 2 5 4-5 4Z"/></svg>
      <span class="motion-label">Pause</span>
    </button>
  </div>

  <div class="viewport" role="group" aria-label="Historical blocks and live Ethereum blocks travel along two separate rails into capability-aware source adapters and the same BlockEnvelope. A floating stack validates canonicality and provenance, then shares material with configured processors. Each has its own parallel map and ordered reduce to produce policy-shaped SQLite state and durable delivery. Raw bytes are optional after commit.">
    <div class="annotation history-label mono" aria-hidden="true"><span class="annotation-kicker">HISTORICAL LANE</span><strong>Backfill the past.</strong><span>Xatu · EraE · retained raw</span></div>
    <div class="annotation live-label mono" aria-hidden="true"><span class="annotation-kicker"><i></i> LIVE LANE</span><strong>Follow the head.</strong><span>Ethereum P2P · CL finality</span></div>
    <div class="annotation core-label mono" aria-hidden="true"><span class="annotation-kicker">ONE SHARED CONTRACT</span><strong>One input. Your processors.</strong></div>
    <div class="annotation output-label mono" aria-hidden="true"><span class="annotation-kicker">YOUR APPLICATION</span><strong>Keep what matters.</strong><span>State + durable delivery</span></div>

    <div class="camera" aria-hidden="true">
      <div class="orient"><EngineWorld idPrefix="pipeline" /></div>
    </div>
    <div class="scene-note mono" aria-hidden="true"><span>Shared input</span><span class="note-line"></span><span>Independent processors</span></div>
  </div>
  <div class="pipeline-explorer">
    <div class="explorer-heading"><span class="mono">INSIDE THE PIPELINE</span><span class="explore-hint" hidden>Hover a layer or select a stage to explore</span></div>
    <div class="stage-controls" role="group" aria-label="Explore pipeline stages" hidden>
      {pipelineStages.map((stage, index) => (
        <button type="button" data-select-stage={stage.id} aria-pressed={stage.id === initialStage.id ? 'true' : 'false'} aria-controls="pipeline-stage-detail"><span class="mono">0{index + 1}</span>{stage.label}</button>
      ))}
    </div>
    <div class="inspector">
      <div id="pipeline-stage-detail" class="stage-detail" aria-live="polite" aria-atomic="true">
        <p class="detail-key mono" data-stage-label>{initialStage.label}</p>
        <h3 data-stage-title>{initialStage.title}</h3>
        <p data-stage-description>{initialStage.description}</p>
      </div>
      <div class="processor-detail">
        <div class="processor-choices" role="group" aria-label="Explore example processors" hidden>
          {pipelineProcessors.map((processor) => (
            <button type="button" data-select-processor={processor.id} style={`--processor-color: ${processor.color}`} aria-pressed="false" aria-controls="pipeline-processor-detail"><i></i>{processor.label}</button>
          ))}
        </div>
        <div id="pipeline-processor-detail" aria-live="polite" aria-atomic="true">
          <p class="processor-summary" data-processor-summary>Built-in or your own Rust. Each processor owns both steps.</p>
          <dl><div><dt class="mono">map()</dt><dd data-processor-map>Block material → compact delta</dd></div><div><dt class="mono">reduce()</dt><dd data-processor-reduce>Ordered delta → state + changes</dd></div></dl>
          <a data-processor-link href="/docs/guides/custom-processor/">Build your processor →</a>
        </div>
      </div>
    </div>
    <p class="engine-footnote">Xatu is trusted; EraE commitments are checked. Live P2P provenance and CL finality stay explicit. Raw bytes are optional after commit.</p>
  </div>
</pipeline-scene>

<script>
  import { pipelineStages, pipelineProcessors } from '../data/pipeline';

  class PipelineScene extends HTMLElement {
    connectedCallback() {
      const viewport = this.querySelector<HTMLElement>('.viewport')!;
      const camera = this.querySelector<HTMLElement>('.camera')!;
      const button = this.querySelector<HTMLButtonElement>('.motion-toggle')!;
      const label = this.querySelector<HTMLElement>('.motion-label')!;
      const stageControls = this.querySelector<HTMLElement>('.stage-controls')!;
      const processorChoices = this.querySelector<HTMLElement>('.processor-choices')!;
      const hint = this.querySelector<HTMLElement>('.explore-hint')!;
      const stageLabel = this.querySelector<HTMLElement>('[data-stage-label]')!;
      const stageTitle = this.querySelector<HTMLElement>('[data-stage-title]')!;
      const stageDescription = this.querySelector<HTMLElement>('[data-stage-description]')!;
      const processorSummary = this.querySelector<HTMLElement>('[data-processor-summary]')!;
      const processorMap = this.querySelector<HTMLElement>('[data-processor-map]')!;
      const processorReduce = this.querySelector<HTMLElement>('[data-processor-reduce]')!;
      const processorLink = this.querySelector<HTMLAnchorElement>('[data-processor-link]')!;
      let activeStage = 'map';
      let activeProcessor: string | null = null;
      const inspect = (stageId: string, processorId = activeProcessor) => {
        const stage = pipelineStages.find(item => item.id === stageId);
        if (!stage) return;
        const processor = ['map', 'reduce'].includes(stage.id) ? pipelineProcessors.find(item => item.id === processorId) : undefined;
        activeStage = stage.id;
        activeProcessor = processor?.id ?? null;
        this.dataset.stage = activeStage;
        this.dataset.processor = activeProcessor ?? '';
        stageLabel.textContent = stage.label;
        stageTitle.textContent = stage.title;
        stageDescription.textContent = stage.description;
        processorSummary.textContent = processor ? `${processor.label} → ${processor.output}` : 'Built-in or your own Rust. Each processor owns both steps.';
        processorMap.textContent = processor?.map ?? 'Block material → compact delta';
        processorReduce.textContent = processor?.reduce ?? 'Ordered delta → state + changes';
        processorLink.href = processor?.href ?? '/docs/guides/custom-processor/';
        processorLink.textContent = processor ? (processor.id === 'custom' ? 'Build your processor →' : 'Processor contract →') : 'Build your processor →';
        this.querySelectorAll<HTMLElement>('[data-stage-target]').forEach(element => element.classList.toggle('is-active', element.dataset.stageTarget === activeStage));
        this.querySelectorAll<HTMLElement>('[data-processor-target]').forEach(element => element.classList.toggle('is-selected', element.dataset.processorTarget === activeProcessor));
        this.querySelectorAll<HTMLButtonElement>('[data-select-stage]').forEach(element => element.setAttribute('aria-pressed', String(element.dataset.selectStage === activeStage)));
        this.querySelectorAll<HTMLButtonElement>('[data-select-processor]').forEach(element => element.setAttribute('aria-pressed', String(element.dataset.selectProcessor === activeProcessor)));
      };
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const events = new AbortController();
      let paused = false;
      let visible = false;
      let pointerFrame = 0;
      const resetTilt = () => {
        cancelAnimationFrame(pointerFrame);
        pointerFrame = 0;
        camera.style.setProperty('--tilt-x', '0deg');
        camera.style.setProperty('--tilt-z', '0deg');
      };
      const update = () => {
        const running = !paused && !reducedMotion.matches && visible && !document.hidden;
        this.dataset.running = String(running);
        button.hidden = reducedMotion.matches;
        button.setAttribute('aria-pressed', String(paused));
        button.setAttribute('aria-label', paused ? 'Play pipeline animation' : 'Pause pipeline animation');
        label.textContent = paused ? 'Play' : 'Pause';
        if (!running) resetTilt();
      };
      const resize = new ResizeObserver(([entry]) => {
        camera.style.setProperty('--scene-scale', String(Math.min(1, entry.contentRect.width / 1060)));
      });
      const intersection = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      }, { threshold: 0.08 });
      button.addEventListener('click', () => { paused = !paused; update(); }, { signal: events.signal });
      reducedMotion.addEventListener('change', update, { signal: events.signal });
      document.addEventListener('visibilitychange', update, { signal: events.signal });
      viewport.addEventListener('pointermove', (event) => {
        if (this.dataset.running !== 'true' || !finePointer.matches || pointerFrame) return;
        pointerFrame = requestAnimationFrame(() => {
          const bounds = viewport.getBoundingClientRect();
          camera.style.setProperty('--tilt-x', `${((event.clientY - bounds.top) / bounds.height - 0.5) * -5}deg`);
          camera.style.setProperty('--tilt-z', `${((event.clientX - bounds.left) / bounds.width - 0.5) * 5}deg`);
          pointerFrame = 0;
        });
      }, { signal: events.signal });
      viewport.addEventListener('pointerleave', resetTilt, { signal: events.signal });
      this.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-select-stage], [data-select-processor]') : null;
        if (target?.dataset.selectStage) inspect(target.dataset.selectStage);
        if (target?.dataset.selectProcessor) inspect(['map', 'reduce'].includes(activeStage) ? activeStage : 'map', target.dataset.selectProcessor);
      }, { signal: events.signal });
      this.addEventListener('focusin', (event) => {
        const target = event.target as HTMLElement;
        if (target.dataset.selectStage) inspect(target.dataset.selectStage);
        if (target.dataset.selectProcessor) inspect(['map', 'reduce'].includes(activeStage) ? activeStage : 'map', target.dataset.selectProcessor);
      }, { signal: events.signal });
      viewport.addEventListener('pointerover', (event) => {
        if (!finePointer.matches || !(event.target instanceof Element)) return;
        const stage = event.target.closest<HTMLElement>('[data-stage-target]');
        const processor = event.target.closest<HTMLElement>('[data-processor-target]');
        if (stage) {
          if (stage.dataset.stageTarget !== activeStage || (processor?.dataset.processorTarget ?? null) !== activeProcessor) inspect(stage.dataset.stageTarget!, processor?.dataset.processorTarget ?? null);
        }
      }, { signal: events.signal });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.contains(document.activeElement)) inspect('map', null);
      }, { signal: events.signal });
      stageControls.hidden = false;
      processorChoices.hidden = false;
      hint.hidden = false;
      inspect('map');
      resize.observe(viewport);
      intersection.observe(viewport);
      update();
      this.cleanup = () => { events.abort(); resize.disconnect(); intersection.disconnect(); resetTilt(); };
    }
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('pipeline-scene')) customElements.define('pipeline-scene', PipelineScene);
</script>

<style>
  .engine { display: block; margin-top: 2.8rem; border: 1px solid var(--panel-edge); border-radius: 12px; background: #0b110e; overflow: hidden; }
  .engine-bar { display: flex; justify-content: space-between; align-items: center; min-height: 3.4rem; margin-inline: 1.5rem; border-bottom: 1px solid #1c2b23; font-size: 0.65rem; letter-spacing: 0.13em; color: var(--ink-dim); }
  .engine-bar > span { display: flex; align-items: center; gap: 0.65rem; }
  .status-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px #3ee07f55; }
  .motion-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; min-width: 5rem; min-height: 2.75rem; margin-right: -0.6rem; border: 0; background: transparent; color: var(--ink-dim); font: inherit; letter-spacing: 0; cursor: pointer; }
  .motion-toggle[hidden] { display: none; }
  .motion-toggle:hover { color: var(--accent); }
  .motion-toggle svg { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .play-icon, [aria-pressed='true'] .pause-icon { display: none; }
  [aria-pressed='true'] .play-icon { display: block; }
  .viewport { height: 660px; position: relative; isolation: isolate; background: radial-gradient(ellipse at 54% 48%, #14362255, transparent 57%); overflow: hidden; }
  .camera { --scene-scale: 1; position: absolute; width: 860px; height: 480px; left: 50%; top: 57%; margin: -240px 0 0 -430px; transform: scale(var(--scene-scale)); perspective: 1800px; }
  .orient { width: 100%; height: 100%; transform-style: preserve-3d; transform: rotateX(calc(55deg + var(--tilt-x, 0deg))) rotateZ(calc(-30deg + var(--tilt-z, 0deg))); transition: transform 600ms cubic-bezier(0.2, 0.65, 0.3, 1); }
  .annotation { position: absolute; z-index: 1; display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.78rem; line-height: 1.5; color: #bad0c2; pointer-events: none; }
  .annotation strong { font-family: var(--font-sans); color: #d5e9dc; font-size: 1.05rem; font-weight: 550; letter-spacing: -0.01em; }
  .annotation-kicker { color: #a2c3ae; letter-spacing: 0.06em; font-size: 0.72rem; }
  .history-label { left: 5%; top: 21%; }
  .live-label { left: 4%; bottom: 10%; }
  .live-label .annotation-kicker { color: #76d795; }
  .annotation i { display: inline-block; width: 5px; height: 5px; margin-bottom: 1px; background: var(--accent); border-radius: 50%; }
  .core-label { top: 5%; left: 43%; }
  .core-label::after { content: ''; display: block; height: 35px; width: 1px; margin-top: 8px; background: linear-gradient(#65977477, transparent); }
  .output-label { right: 3%; top: 27%; }
  .scene-note { position: absolute; bottom: 22px; right: 24px; display: flex; align-items: center; justify-content: center; gap: 12px; color: #aec6b7; font-size: 0.75rem; letter-spacing: 0.03em; }
  .note-line { width: 42px; height: 1px; background: #3e7050; }
  .pipeline-explorer { padding: 1.5rem; border-top: 1px solid #2e4637; background: #0e1812; }
  .explorer-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: 1rem; }
  .explorer-heading .mono { color: #b0cbb9; font-size: 0.73rem; letter-spacing: 0.06em; }
  .explore-hint { color: #94b29f; font-size: 0.8rem; }
  .stage-controls { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.5rem; }
  .stage-controls[hidden], .processor-choices[hidden], .explore-hint[hidden] { display: none; }
  .stage-controls button { display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.7rem 0.4rem; min-height: 44px; border: 1px solid #304939; border-radius: 5px; background: #121f17; color: #c5ddce; font: 500 0.85rem var(--font-sans); cursor: pointer; }
  .stage-controls button span { color: #85aa92; font-size: 0.7rem; }
  .stage-controls button[aria-pressed='true'] { color: #e8fff0; border-color: #7cdb9d; background: #203c2b; }
  .stage-controls button[aria-pressed='true'] span { color: #9af0b8; }
  .stage-controls button:hover, .processor-choices button:hover { border-color: #9dceb0; }
  .inspector { display: grid; grid-template-columns: 1fr 1.35fr; gap: 2rem; margin-top: 1.5rem; }
  .detail-key { margin-bottom: 0.6rem; color: #9befb6; font-size: 0.78rem; }
  .stage-detail h3 { color: #eef9f2; font-size: 1.25rem; line-height: 1.3; text-wrap: initial; margin-bottom: 0.65rem; }
  .stage-detail > p:last-child { color: #aec8b8; font-size: 0.9rem; line-height: 1.7; }
  .processor-detail { border-left: 1px solid #304939; padding-left: 2rem; }
  .processor-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; margin-bottom: 1rem; }
  .processor-choices button { display: flex; gap: 0.55rem; align-items: center; min-height: 42px; padding: 0.55rem 0.7rem; border: 1px solid #304939; border-radius: 5px; background: #111e16; color: #d3e7da; font: 0.82rem var(--font-sans); text-align: left; cursor: pointer; }
  .processor-choices button i { width: 6px; height: 6px; flex-shrink: 0; background: var(--processor-color); border-radius: 2px; }
  .processor-choices button[aria-pressed='true'] { border-color: var(--processor-color); color: var(--processor-color); background: color-mix(in srgb, var(--processor-color) 9%, #111e16); }
  .processor-summary { font-size: 0.85rem; color: #e3f4e9; margin-bottom: 0.7rem; min-height: 2.7em; }
  .processor-detail dl { display: grid; gap: 0.55rem; font-size: 0.83rem; line-height: 1.55; }
  .processor-detail dl div { display: grid; grid-template-columns: 5.4rem 1fr; gap: 0.5rem; }
  .processor-detail dt { color: #b7e5c7; }
  .processor-detail dd { color: #abc7b6; }
  .processor-detail a { display: inline-block; margin-top: 1rem; font-size: 0.85rem; }
  .engine-footnote { border-top: 1px solid #253b2d; margin-top: 1.4rem; padding-top: 1rem; font-size: 0.78rem; line-height: 1.65; color: #9bb9a7; }
  @media (max-width: 1000px) {
    .viewport { height: 570px; }
    .camera { --scene-scale: 0.75; top: 59%; }
    .history-label { top: 18%; left: 4%; }
    .core-label { left: 39%; }
    .output-label { right: 3%; top: 29%; }
    .live-label { left: 4%; bottom: 12%; }
    .annotation strong { font-size: 0.95rem; }
    .annotation { font-size: 0.7rem; }
    .annotation-kicker { font-size: 0.64rem; }
    .stage-controls { grid-template-columns: repeat(3, 1fr); }
    .inspector { gap: 1.25rem; }
    .processor-detail { padding-left: 1.25rem; }
    .explore-hint { display: none; }
  }
  /* Conservative scales keep the full static scene visible without JavaScript. */
  @media (max-width: 760px) { .camera { --scene-scale: 0.53; } }
  @media (max-width: 600px) {
    .engine { margin-top: 2rem; }
    .engine-bar { margin-inline: 1rem; font-size: 0.7rem; }
    .viewport { height: 400px; }
    .camera { --scene-scale: 0.26; top: 57%; }
    .annotation { font-size: 0.7rem; gap: 0.2rem; }
    .annotation strong { font-size: 0.84rem; }
    .annotation-kicker { font-size: 0.62rem; }
    .core-label { left: 0; right: 0; top: 5%; text-align: center; }
    .core-label::after { height: 18px; margin: 3px auto 0; }
    .history-label { top: 29%; left: 5%; }
    .history-label > span:last-child, .live-label > span:last-child, .output-label > span:last-child { display: none; }
    .live-label { left: 6%; bottom: 13%; }
    .output-label { right: 5%; top: 73%; text-align: right; }
    .scene-note { bottom: 14px; left: 0; right: 0; font-size: 0.65rem; gap: 8px; }
    .note-line { width: 20px; }
    .pipeline-explorer { padding: 1rem; }
    .stage-controls { grid-template-columns: 1fr 1fr; }
    .stage-controls button:last-child { grid-column: 1 / -1; }
    .stage-controls button { justify-content: flex-start; padding-inline: 0.7rem; font-size: 0.82rem; }
    .inspector { grid-template-columns: 1fr; gap: 1.25rem; }
    .stage-detail { min-height: 12.5rem; }
    .processor-detail { border-left: 0; border-top: 1px solid #304939; padding: 1.25rem 0 0; }
    .processor-choices button { font-size: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orient { transition: none; }
  }
</style>
