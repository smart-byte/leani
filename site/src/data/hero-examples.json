[
  {
    "id": "quickstart",
    "label": "quickstart",
    "title": "leani — index public Mainnet data",
    "note": "1,000 real blocks from public Xatu; no API key and no EVM execution",
    "lang": "shell",
    "lines": [
      { "text": "$ brew install leani-dev/tap/leani", "charMs": 8 },
      { "text": "$ mkdir leani-quickstart && cd leani-quickstart", "delayMs": 80, "charMs": 6 },
      { "text": "$ curl -fsSLo leani.toml \\", "delayMs": 80, "charMs": 8 },
      { "text": "    https://raw.githubusercontent.com/smart-byte/leani/v0.1.0/config/modes/windowed.toml", "charMs": 3 },
      { "text": "$ leani backfill --processor uniswap-v2-sync-30d \\", "delayMs": 80, "charMs": 6 },
      { "text": "    --from 10000835 --to 10001834", "charMs": 6 },
      { "text": "", "delayMs": 80 },
      { "text": "source    xatu · public Ethereum Mainnet history", "className": "t-dim", "delayMs": 150, "charMs": 2 },
      { "text": "processor uniswap-v2-sync-30d · 1,000 frames committed", "delayMs": 120, "charMs": 2 },
      { "text": "coverage  10000835..10001834 · continuous · finalized", "className": "t-accent", "delayMs": 120, "charMs": 2 },
      { "text": "", "delayMs": 100 },
      { "text": "$ █", "charMs": 0, "delayMs": 200 }
    ]
  },
  {
    "id": "rpc",
    "label": "rpc subset",
    "title": "watch.ts — existing clients, advertised methods",
    "note": "exact when the configured source or retained material satisfies the request",
    "lang": "ts",
    "lines": [
      { "text": "// use leani for the block/receipt/log methods it advertises", "className": "t-dim", "charMs": 3 },
      { "text": "import { createPublicClient, http, webSocket } from \"viem\";", "delayMs": 80, "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "const eth = createPublicClient({", "charMs": 3 },
      { "text": "  transport: http(\"http://localhost:8545\"),", "charMs": 3 },
      { "text": "});", "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "const receipts = await eth.getBlockReceipts({ blockNumber: 19426589n });", "charMs": 3 },
      { "text": "// exact post-Merge response from capable historical material", "className": "t-accent", "delayMs": 150, "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "const live = createPublicClient({ transport: webSocket(\"ws://localhost:8546\") });", "charMs": 3 },
      { "text": "live.watchBlocks({ onBlock: (block) => update(block) });", "charMs": 3 },
      { "text": "// reorg-correct newHeads — replacement heads after branch commit", "className": "t-accent", "delayMs": 150, "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "// not served: eth_call · eth_getBalance · state methods — no EVM, no pretending", "className": "t-dim", "delayMs": 100, "charMs": 3 }
    ],
    "noteHref": "#rpc",
    "noteLabel": "served vs refused, in full →"
  },
  {
    "id": "sdk",
    "label": "typescript sdk",
    "title": "consume.ts — typed processor data",
    "note": "at-least-once transport; commit application data and cursor before ACK",
    "lang": "ts",
    "lines": [
      { "text": "import { commitThenAcknowledge, createLeaniClient } from \"@leani/sdk\";", "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "const leani = createLeaniClient({ baseUrl: \"http://localhost:8080\" });", "charMs": 3 },
      { "text": "", "delayMs": 60 },
      { "text": "const page = await leani.processors.consumers.changes(", "charMs": 3 },
      { "text": "  \"blobs-production\", \"blobs-api\", credential,", "charMs": 3 },
      { "text": ");", "charMs": 3 },
      { "text": "for (const event of page.data) {", "charMs": 3 },
      { "text": "  await commitThenAcknowledge(", "charMs": 3 },
      { "text": "    () => db.applyAndSaveCursor(event),", "charMs": 3 },
      { "text": "    (cursor) => leani.processors.consumers.acknowledge(", "charMs": 3 },
      { "text": "      \"blobs-production\", \"blobs-api\", credential, cursor,", "charMs": 3 },
      { "text": "    ),", "charMs": 3 },
      { "text": "  );", "charMs": 3 },
      { "text": "}", "charMs": 3 },
      { "text": "", "delayMs": 100 },
      { "text": "committed + acknowledged blobs.block.put  #25696397", "className": "t-accent", "delayMs": 120, "charMs": 2 },
      { "text": "committed + acknowledged blobs.block.put  #25696398", "className": "t-accent", "delayMs": 120, "charMs": 2 }
    ]
  }
]
