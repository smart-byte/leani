---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalityStage from '../components/FinalityStage.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import { hlShell, hlToml, hlTs } from '../lib/highlight';
import { CHAINS, FAMILY_LABELS, STAGES, type Family, type Stage } from '../lib/live/model';

const families: Family[] = ['op-stack', 'ethereum', 'arbitrum'];
const columns = [
  ['block', 'block time'], ['seen', 'seen after'], ['attested', 'signed after'], ['posted', 'in a blob after'],
  ['confirmed', 'confirmed after'], ['finalized', 'final after'], ['settled', 'settled'],
];
const anchored = CHAINS.filter((chain) => chain.settlement);
const claims: Record<string, string> = {
  'dispute games': 'Op-stack fault proofs: a proposer claims the chain’s state at one block, its output root, in a game on Ethereum that anyone can challenge. Once the claim outlasts its challenge window, the anchor state registry moves to it and withdrawals up to that block can complete.',
  'super-root games': 'Dispute games whose claim is a super root: one commitment to the output roots of several interoperating chains at the same moment. leani checks OP Mainnet’s own root inside it; otherwise the game works like any dispute game.',
  BoLD: 'Arbitrum’s dispute protocol, Bounded Liquidity Delay. About every hour a validator posts an assertion naming the block hash at the end of a range, and the rollup confirms it after a 6.4-day challenge period. However many parties dispute an assertion, BoLD resolves it within a fixed time.',
};
/** A stage's typical time: once when every chain shares it, else per chain in the page's chain order. */
const timings = (typical: Stage['typical']) => {
  if (typeof typical === 'string') return [{ chain: null, value: typical }];
  const values = new Set(Object.values(typical));
  if (values.size === 1) return [{ chain: null, value: [...values][0] }];
  return CHAINS.filter((chain) => chain.id in typical).map((chain) => ({ chain, value: typical[chain.id] }));
};

const levels = [
  {
    level: 'unattested',
    title: 'Fastest',
    use: 'UIs that show activity the moment it happens and can take a block back.',
    toml: 'publish = "unattested"  # the default',
    cli: 'leani subscribe blocks',
  },
  {
    level: 'attested',
    title: 'Signed',
    use: 'Apps that must never act on a block nobody vouched for: Ethereum’s sync committee, or the rollup’s sequencer.',
    toml: 'publish = "attested"',
    cli: 'leani subscribe blocks --finality attested',
  },
  {
    level: 'confirmed',
    title: 'Confirmed',
    use: 'Deposits and payouts on Ethereum that cannot wait a quarter of an hour: the fast confirmation rule, as the consensus nodes you name report it.',
    toml: 'publish = "confirmed"',
    cli: 'leani subscribe blocks --finality confirmed',
  },
  {
    level: 'finalized',
    title: 'Final',
    use: 'Accounting and anything that cannot be undone: Ethereum finality, or the rollup’s batch final on Ethereum.',
    toml: 'publish = "finalized"',
    cli: 'leani subscribe blocks --finality finalized',
  },
  {
    level: 'settled',
    title: 'Settled',
    use: 'Withdrawals and bridges that wait for Ethereum to accept the rollup’s state, days after its blocks.',
    toml: 'publish = "settled"',
    cli: 'leani subscribe blocks --finality settled',
  },
];

const sdk = `import { createLeaniClient } from "@smart-byte/leani-sdk";

const leani = createLeaniClient({ baseUrl: "http://127.0.0.1:18080" });
for await (const change of leani.blocks.subscribe()) {
  switch (change.operation) {
    case "apply":     show(change.data, change.finality); break;
    case "attested":
    case "confirmed":
    case "finalized":
    case "settled":   promote(change.data, change.operation); break;
    case "undo":      remove(change.block); break;
  }
}`;

const blobs = `// On an Ethereum node that runs the blobs processor
for await (const change of leani.blobs.subscribe()) {
  for (const blob of change.data?.transactions ?? []) {
    // OP Mainnet's batcher posts to 0xff…0010
    if (blob.toAddress === OP_BATCH_INBOX) posted(change.block, blob.blobVersionedHashes);
  }
}`;

const run = `cd leani/examples/finality-live
./nodes.sh init ./nodes
./nodes.sh start ./nodes
bun hub.ts $(./nodes.sh hub ./nodes) \\
  --beacon https://ethereum-beacon-api.publicnode.com \\
  --fcr https://lodestar-mainnet.chainsafe.io --port 8797
open "https://leani.dev/finality?hub=http://127.0.0.1:8797"`;
---
<Base
  title="Finality, live — leani"
  description="Watch rollup blocks travel to Ethereum as blobs and settle there, live, as leani sees them."
>
  <Header slot="before-main" />
  <section class="hero wrap" aria-labelledby="live-h">
    <h1 id="live-h">Watch rollup blocks settle on Ethereum.</h1>
    <p class="lede">
      Rollups sign a block every second or faster and post it to Ethereum in a blob within
      minutes. From then on it is as final as the Ethereum block that carries it: confirmed in
      about 13 seconds, final in about 15 minutes, settled for withdrawals in days. Every block
      below is one leani saw.
    </p>
    <div class="status mono" role="status">
      <span class="dot" data-status-dot></span><span data-status>connecting…</span>
    </div>
  </section>

  <section aria-label="Live blocks and blobs">
    <FinalityStage />
  </section>

  <section class="section wrap" aria-labelledby="table-h">
    <h2 id="table-h"><span class="mono"># </span>Right now</h2>
    <p class="sub">Medians over the blocks above, from when each block was made. ~ marks Ethereum’s own times, until a batch seen live gets there.</p>
    <div class="pick mono" role="group" aria-label="Chain">
      {CHAINS.map((chain, index) => (
        <button type="button" data-pick={chain.id} aria-pressed={index === 0 ? 'true' : 'false'}><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label.replace(/ (Mainnet|One|Chain)$/, '')}</button>
      ))}
    </div>
    <div class="table-scroll">
      <table class="lanes mono">
        <thead>
          <tr><th scope="col">chain</th>{columns.map(([, label]) => <th scope="col">{label}</th>)}</tr>
        </thead>
        <tbody data-table>
          {CHAINS.map((chain, index) => (
            <tr data-chain={chain.id} class:list={{ picked: index === 0 }}>
              <th scope="row"><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label}</th>
              {columns.map(([cell, label]) => <td data-cell={cell} data-label={label}>—</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="stages-h">
    <h2 id="stages-h"><span class="mono"># </span>What each stage means</h2>
    <p class="sub">Solid cards are levels leani reports; dashed ones are milestones it does not.</p>
    <div class="tabs mono" role="tablist">
      {families.map((family, index) => (
        <button type="button" role="tab" id={`tab-${family}`} aria-controls={`panel-${family}`} aria-selected={index === 0 ? 'true' : 'false'} data-tab={family}>{FAMILY_LABELS[family]}</button>
      ))}
    </div>
    {families.map((family, index) => (
      <div class="panel" role="tabpanel" id={`panel-${family}`} aria-labelledby={`tab-${family}`} hidden={index !== 0} data-panel={family}>
        <ol class="stages">
          {STAGES[family].map((stage) => (
            <li class:list={['stage-card', { milestone: stage.level === null }]}>
              <p class="stage-level mono">{stage.level ?? 'milestone'}</p>
              <h3>{stage.name}</h3>
              <p>{stage.evidence}</p>
              <p class="typical"><span class="mono">typical</span><span class="timings">{timings(stage.typical).map(({ chain, value }) => (
                <span class="timing">{chain && <><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label} </>}<b>{value}</b></span>
              ))}</span></p>
              <p class="undo"><span class="mono">undone by</span> {stage.undo}</p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="section wrap" aria-labelledby="consume-h">
    <h2 id="consume-h"><span class="mono"># </span>Consume the level you need</h2>
    <p class="sub">A processor publishes from one level up; its stream marks every later rise. Pick the first level your app may act on.</p>
    <div class="levels">
      {levels.map((item) => (
        <article class="level-card">
          <p class="stage-level mono">{item.level}</p>
          <h3>{item.title}</h3>
          <p>{item.use}</p>
          {[[item.toml, hlToml(item.toml), 'setting'], [item.cli, hlShell(item.cli), 'command']].map(([text, html, kind]) => (
            <div class="snippet">
              <pre class="mono"><code set:html={html} /></pre>
              <button type="button" class="copy" data-copy={text} aria-label={`Copy the ${item.level} ${kind}`}>
                <svg viewBox="0 0 16 16" aria-hidden="true"><g class="sheets"><rect x="5.5" y="5.5" width="8" height="8" rx="1.6"/><path d="M10.5 3.2V3A1.5 1.5 0 0 0 9 1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3"/></g><path class="tick" d="M3 8.5l3.2 3L13 4.5"/></svg>
              </button>
            </div>
          ))}
        </article>
      ))}
    </div>
    <p class="copied" role="status" data-copied></p>
    <p class="sub note">The CLI follows Ethereum Mainnet; on any chain’s node, the SDK reads the same levels from one stream:</p>
    <TerminalFrame title="every level from one stream">
      <pre><code set:html={sdk.split('\n').map(hlTs).join('\n')} /></pre>
    </TerminalFrame>
    <p class="sub note">The Ethereum node runs the <code>blobs</code> processor, which names each blob transaction’s sender and the address it posts to: that is how the page knows whose blob it is. The hub fetches the blobs from a Beacon API and decodes the blocks inside.</p>
    <TerminalFrame title="which Ethereum block carries a rollup’s blobs">
      <pre><code set:html={blobs.split('\n').map(hlTs).join('\n')} /></pre>
    </TerminalFrame>
  </section>

  <section class="section wrap bedrock" aria-labelledby="bedrock-h">
    <h2 id="bedrock-h"><span class="mono"># </span>Two ways to rest on Ethereum</h2>
    <div class="cols">
      <div>
        <p>
          <strong>Data.</strong> Once the Ethereum block carrying a rollup block’s batch is final,
          anyone can derive the block from Ethereum and it can no longer change. That is
          leani’s <code>finalized</code> for a rollup, as op-node and Nitro call it: leani reads the batches
          from finalized Ethereum blocks. It takes minutes and shows as a dashed line in each rollup’s
          row.
        </p>
        <p>
          <strong>Settlement.</strong> For withdrawals, Ethereum must also accept the rollup’s claim
          about its state, after a challenge window of days. That is leani’s <code>settled</code>, read
          from the settlement contracts’ logs in finalized Ethereum blocks, no RPC trusted. The
          picture’s right edge names how long each rollup takes, and opens onto those days once a
          node that holds them reports a settled block.
        </p>
      </div>
      <ul class="anchors mono">
        {anchored.map((chain) => (
          <li>
            <i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label}
            <span>{chain.settlement!.via}<button type="button" class="hint" popovertarget={`claims-${chain.id}`} style={`anchor-name: --claims-${chain.id}`} aria-label={`About ${chain.settlement!.via}`}>?</button>, {chain.settlement!.typical}</span>
            <div id={`claims-${chain.id}`} class="claims" popover style={`position-anchor: --claims-${chain.id}`}>{claims[chain.settlement!.via]}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="run-h">
    <h2 id="run-h"><span class="mono"># </span>Run it yourself</h2>
    <p class="sub">The example starts one node per chain, Ethereum’s with the blobs processor. Its hub follows them with the SDK, decodes the batches, reads fast confirmations from a beacon node, and streams this page. Op-stack nodes need a public address for their gossip.</p>
    <TerminalFrame title="shell">
      <pre><code set:html={run.split('\n').map(hlShell).join('\n')} /></pre>
    </TerminalFrame>
  </section>
  <Footer slot="after-main" />
</Base>

<script>
  import { duration, type Passage } from '../lib/live/scene';
  import { mountStage } from '../lib/live/stage';
  import { CHAINS } from '../lib/live/model';

  const selectFamily = (family: string) => {
    for (const tab of document.querySelectorAll<HTMLElement>('[data-tab]')) {
      tab.setAttribute('aria-selected', String(tab.dataset.tab === family));
    }
    for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
      panel.hidden = panel.dataset.panel !== family;
    }
  };
  for (const tab of document.querySelectorAll<HTMLElement>('[data-tab]')) {
    tab.addEventListener('click', () => selectFamily(tab.dataset.tab!));
  }

  const copied = document.querySelector<HTMLElement>('[data-copied]')!;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.classList.add('done');
        copied.textContent = 'Copied.';
      } catch {
        copied.textContent = 'Copy failed. Select the text instead.';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('done');
        copied.textContent = '';
      }, 1600);
    });
  }

  const { scene, present } = await mountStage(document.querySelector<HTMLElement>('[data-stage]')!);

  const put = (element: HTMLElement | null | undefined, value: string) => {
    if (element && element.textContent !== value) element.textContent = value;
  };
  const range = (pair: [number, number] | null) => (pair ? `${duration(pair[0])} – ${duration(pair[1])}` : '—');
  const about = (estimated: boolean) => (estimated ? '~' : '');
  const keep = (text: string) => text.replaceAll(' ', '\u00a0');

  const cells = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-chain]')].map((row) => [row.dataset.chain!, row]),
  );
  // Narrow screens show one chain's row at a time, picked with these buttons.
  const picks = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  let picked = CHAINS[0].id;
  const pick = (chain: string) => {
    picked = chain;
    for (const button of picks) button.setAttribute('aria-pressed', String(button.dataset.pick === chain));
    for (const [id, row] of cells) row.classList.toggle('picked', id === chain);
  };
  for (const button of picks) button.addEventListener('click', () => pick(button.dataset.pick!));
  const rollupCells = (passage: Passage | null) => {
    if (!passage) return { posted: '—', confirmed: '—', finalized: '—' };
    const posted = passage.postedAfter;
    const confirmed = posted && passage.confirmedAfterPosting !== null
      ? `${about(passage.estimated.confirmed)}${range([posted[0] + passage.confirmedAfterPosting, posted[1] + passage.confirmedAfterPosting])}`
      : '—';
    return {
      // A narrow list breaks this between its two parts only.
      posted: posted ? `${keep(range(posted))}${passage.every ? ` · ${keep(`every ${duration(passage.every)}`)}` : ''}` : 'no batch yet',
      confirmed,
      finalized: passage.finalAfter ? `${about(passage.estimated.final)}${range(passage.finalAfter)}` : '—',
    };
  };
  const refresh = () => {
    const chains = present();
    for (const button of picks) button.hidden = !chains.includes(button.dataset.pick!);
    if (!chains.includes(picked) && chains.length) pick(chains[0]);
    for (const summary of scene.summaries()) {
      const row = cells.get(summary.chain.id);
      if (!row) continue;
      row.hidden = !chains.includes(summary.chain.id);
      row.classList.toggle('quiet', summary.head === null);
      const cell = (name: string) => row.querySelector<HTMLElement>(`[data-cell="${name}"]`);
      put(cell('block'), summary.blockSeconds === null ? '—' : duration(summary.blockSeconds));
      put(cell('seen'), summary.seen === null ? '—' : duration(summary.seen));
      put(cell('attested'), summary.attested === null ? '—' : duration(summary.attested));
      if (summary.chain.family === 'ethereum') {
        put(cell('posted'), 'is the settlement layer');
        put(cell('confirmed'), summary.confirmed === null ? '—' : duration(summary.confirmed));
        put(cell('finalized'), summary.finalized === null ? '—' : duration(summary.finalized));
        put(cell('settled'), '—');
        continue;
      }
      const values = rollupCells(scene.passage(summary.chain.id));
      put(cell('posted'), values.posted);
      put(cell('confirmed'), values.confirmed);
      put(cell('finalized'), values.finalized);
      put(cell('settled'), summary.settledAge !== null ? `newest ${duration(summary.settledAge)} old` : summary.chain.settlement?.typical ?? '—');
    }
  };
  refresh();
  window.setInterval(refresh, 1000);
</script>

<style>
  .hero { padding-block: 3.5rem 1.5rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-block: 0.6rem 1rem; max-width: 22ch; }
  .status { margin-top: 1.25rem; display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.8rem; color: var(--ink-dim); border: 1px solid var(--panel-edge); border-radius: 999px; padding: 0.3rem 0.8rem; }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: #536b5e; }
  .status .dot:global(.on) { background: var(--accent); box-shadow: 0 0 10px var(--accent); }

  .sub { color: var(--ink-dim); max-width: 46rem; margin-block: 0.6rem 1.5rem; }
  .sub code, .bedrock code { font-size: 0.85em; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--panel-edge); border-radius: 10px; }
  .lanes { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
  .lanes th, .lanes td { padding: 0.5rem 0.6rem; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--panel-edge); }
  .lanes th:first-child, .lanes td.source { text-align: left; }
  .lanes thead th { color: var(--ink-dim); font-weight: 500; }
  .lanes tbody tr:last-child > * { border-bottom: 0; }
  .lanes tr.quiet { color: #536b5e; }
  .lanes .source { color: var(--ink-dim); }
  .chip { display: inline-block; width: 9px; height: 9px; border-radius: 2px; background: var(--chain); margin-right: 0.55rem; }

  .tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .tabs button { font: inherit; font-size: 0.82rem; color: var(--ink-dim); background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 8px; padding: 0.45rem 0.9rem; cursor: pointer; }
  .tabs button[aria-selected='true'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .stages { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.9rem; counter-reset: stage; }
  .stage-card, .level-card { background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 10px; padding: 1rem 1.1rem; }
  .stage-card.milestone { background: transparent; border-style: dashed; }
  .stage-card h3, .level-card h3 { font-size: 1.05rem; margin-block: 0.3rem 0.5rem; }
  .stage-card p, .level-card p { color: var(--ink-dim); font-size: 0.9rem; }
  .stage-level { display: flex; justify-content: space-between; gap: 0.6rem; color: var(--accent); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .milestone .stage-level { color: var(--ink-dim); }
  /* Every card in a row shares its five row heights, so titles, timings and undos line up. */
  .stage-card { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0.5rem; }
  .stage-card > * { margin: 0; }
  .undo, .typical { font-size: 0.82rem !important; }
  .undo .mono, .typical > .mono { color: var(--ink); font-size: 0.72rem; margin-right: 0.3rem; }
  .typical { display: flex; align-items: baseline; }
  .timings { display: flex; flex-wrap: wrap; column-gap: 0.7rem; }
  .timing { white-space: nowrap; }
  .timing b { color: var(--ink); font-weight: 500; }
  .timing .chip { margin-right: 0.35rem; }

  .levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); gap: 0.9rem; margin-bottom: 1.2rem; }
  .snippet { position: relative; margin-top: 0.7rem; }
  /* Long lines wrap, continuation lines indented so each reads as one. */
  .snippet pre { font-size: 0.76rem; background: #0b0f0d; border: 1px solid var(--panel-edge); border-radius: 6px; padding: 0.5rem 2.2rem 0.5rem calc(0.65rem + 2ch); text-indent: -2ch; white-space: pre-wrap; overflow-wrap: anywhere; }
  .snippet :global(:is(.hl-flag, .hl-com)) { white-space: nowrap; }
  .copy { position: absolute; top: 0.25rem; right: 0.25rem; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; padding: 0; border: 0; border-radius: 4px; background: none; color: var(--ink-dim); cursor: pointer; }
  .copy:hover, .copy.done { color: var(--accent); }
  .copy svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .copy .tick, .copy.done .sheets { display: none; }
  .copy.done .tick { display: inline; }
  .copied { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .note { margin-top: 1.6rem; }
  .term pre { font-size: 0.8rem; line-height: 1.6; overflow-x: auto; }

  .bedrock .cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem; margin-top: 1.2rem; }
  .bedrock p { color: var(--ink-dim); max-width: 40rem; margin-bottom: 0.9rem; }
  .bedrock strong { color: var(--ink); }
  .anchors { list-style: none; padding: 0; font-size: 0.82rem; }
  .anchors li { display: flex; align-items: center; flex-wrap: wrap; gap: 0.3rem 0.5rem; padding-block: 0.55rem; border-bottom: 1px solid var(--panel-edge); }
  .anchors li span { margin-left: auto; color: var(--ink-dim); }
  .hint { width: 1.2rem; height: 1.2rem; margin-left: 0.35rem; padding: 0; border: 1px solid var(--panel-edge); border-radius: 50%; background: none; color: var(--ink-dim); font: inherit; font-size: 0.7rem; line-height: 1; cursor: pointer; }
  .hint:hover { color: var(--accent); border-color: var(--accent); }
  .claims { max-width: min(21rem, calc(100vw - 2rem)); padding: 0.65rem 0.8rem; background: var(--panel); color: var(--ink); border: 1px solid var(--panel-edge); border-radius: 8px; font: 0.82rem/1.5 var(--font-sans); box-shadow: 0 8px 24px rgb(0 0 0 / 0.45); }
  /* Next to its "?" where the browser can anchor it; elsewhere the popover's own centered default. */
  @supports (position-area: bottom) {
    .claims { inset: 0 0 0 1rem; margin: 0.4rem 0; position-area: bottom span-left; position-try-fallbacks: top span-left; }
  }
  .pick { display: none; }
  @media (max-width: 1099px) {
    /* One chain at a time: its row turns into a list of its numbers. */
    .pick { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.8rem; }
    .pick button { font: inherit; font-size: 0.78rem; color: var(--ink-dim); background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 999px; padding: 0.3rem 0.75rem; cursor: pointer; }
    .pick button[aria-pressed='true'] { color: var(--ink); border-color: var(--ink-dim); }
    .pick button[hidden] { display: none; }
    .pick .chip { margin-right: 0.4rem; }
    .lanes thead { display: none; }
    .lanes, .lanes tbody { display: block; }
    .lanes tbody tr { display: none; }
