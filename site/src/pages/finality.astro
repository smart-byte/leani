---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import { hlShell, hlToml, hlTs } from '../lib/highlight';
import { CHAINS, FAMILY_LABELS, STAGES, type Family } from '../lib/live/model';

const families: Family[] = ['op-stack', 'ethereum', 'arbitrum'];
const columns = [
  ['block', 'block time'], ['seen', 'seen after'], ['attested', 'signed after'], ['posted', 'in a blob after'],
  ['confirmed', 'confirmed after'], ['finalized', 'final after'], ['settled', 'settled'],
];
const anchored = CHAINS.filter((chain) => chain.settlement);

const levels = [
  {
    level: 'unattested',
    title: 'Fastest',
    use: 'UIs that show activity the moment it happens and can take a block back.',
    toml: 'publish = "unattested"  # the default',
    cli: 'leani subscribe blocks',
  },
  {
    level: 'attested',
    title: 'Signed',
    use: 'Apps that must never act on a block nobody vouched for: Ethereum’s sync committee, or the rollup’s sequencer.',
    toml: 'publish = "attested"',
    cli: 'leani subscribe blocks --finality attested',
  },
  {
    level: 'finalized',
    title: 'Final',
    use: 'Accounting, bridges, and anything that cannot be undone: Ethereum finality, or Ethereum settling the rollup.',
    toml: 'publish = "finalized"',
    cli: 'leani subscribe blocks --finality finalized',
  },
];

const sdk = `import { createLeaniClient } from "@smart-byte/leani-sdk";

const leani = createLeaniClient({ baseUrl: "http://127.0.0.1:18080" });
for await (const change of leani.blocks.subscribe()) {
  switch (change.operation) {
    case "apply":     show(change.data, change.finality); break;
    case "attested":
    case "finalized": promote(change.data, change.operation); break;
    case "undo":      remove(change.block); break;
  }
}`;

const blobs = `// On an Ethereum node that runs the blobs processor
for await (const change of leani.blobs.subscribe()) {
  for (const blob of change.data?.transactions ?? []) {
    // OP Mainnet's batcher posts to 0xff…0010
    if (blob.toAddress === OP_BATCH_INBOX) posted(change.block, blob.blobVersionedHashes);
  }
}`;

const run = `cd leani/examples/finality-live
./nodes.sh init ./nodes
./nodes.sh start ./nodes
bun hub.ts $(./nodes.sh hub ./nodes) \\
  --beacon https://ethereum-beacon-api.publicnode.com \\
  --fcr https://lodestar-mainnet.chainsafe.io --port 8797
open "https://leani.dev/finality?hub=http://127.0.0.1:8797"`;
---
<Base
  title="Finality, live — leani"
  description="Watch rollup blocks travel to Ethereum as blobs and settle there, live, as leani sees them."
>
  <Header slot="before-main" />
  <section class="hero wrap" aria-labelledby="live-h">
    <h1 id="live-h">Watch rollup blocks settle on Ethereum.</h1>
    <p class="lede">
      Rollups sign a block every second or faster and post it to Ethereum in a blob within
      minutes. From then on it is as final as the Ethereum block that carries it: confirmed in
      about 13 seconds, final in about 15 minutes, settled for withdrawals in days. Every block
      below is one leani saw.
    </p>
    <div class="status mono" role="status">
      <span class="dot" data-status-dot></span><span data-status>connecting…</span>
    </div>
  </section>

  <section class="stage-wrap" aria-label="Live blocks and blobs">
    <div class="legend wrap mono">
      <span><i class="swatch block"></i>a rollup block, faint until signed</span>
      <span><i class="swatch batch"></i>a batch, threaded to its Ethereum block</span>
      <span><i class="swatch slab"><i></i><i></i><i></i></i>an Ethereum block and its blobs:</span>
      <span><i class="swatch slab seen"></i>seen</span>
      <span><i class="swatch slab attested"></i>attested</span>
      <span><i class="swatch slab confirmed"></i>confirmed, fast confirmation rule</span>
      <span><i class="swatch slab final"></i>finalized</span>
      <span><i class="swatch reorg"></i>reorg</span>
      <span class="buttons">
        <button type="button" class="toggle" data-expand aria-pressed="false">days of settlement ▸</button>
      </span>
    </div>
    <div class="stage">
      <canvas data-canvas aria-hidden="true"></canvas>
      <div class="tip mono" data-tip hidden></div>
    </div>
    <div class="follow wrap mono" data-follow hidden aria-live="polite">
      <b data-follow-title></b>
      <ol data-follow-stages></ol>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="table-h">
    <h2 id="table-h"><span class="mono"># </span>Right now</h2>
    <p class="sub">Medians over the blocks above, from when each block was made. ~ marks Ethereum’s own times, until a batch seen live gets there.</p>
    <div class="pick mono" role="group" aria-label="Chain">
      {CHAINS.map((chain, index) => (
        <button type="button" data-pick={chain.id} aria-pressed={index === 0 ? 'true' : 'false'}><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label.replace(/ (Mainnet|One|Chain)$/, '')}</button>
      ))}
    </div>
    <div class="table-scroll">
      <table class="lanes mono">
        <thead>
          <tr><th scope="col">chain</th>{columns.map(([, label]) => <th scope="col">{label}</th>)}</tr>
        </thead>
        <tbody data-table>
          {CHAINS.map((chain, index) => (
            <tr data-chain={chain.id} class:list={{ picked: index === 0 }}>
              <th scope="row"><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label}</th>
              {columns.map(([cell, label]) => <td data-cell={cell} data-label={label}>—</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="stages-h">
    <h2 id="stages-h"><span class="mono"># </span>What each stage means</h2>
    <p class="sub">Solid cards are levels leani reports; dashed ones are milestones it does not.</p>
    <div class="tabs mono" role="tablist">
      {families.map((family, index) => (
        <button type="button" role="tab" id={`tab-${family}`} aria-controls={`panel-${family}`} aria-selected={index === 0 ? 'true' : 'false'} data-tab={family}>{FAMILY_LABELS[family]}</button>
      ))}
    </div>
    {families.map((family, index) => (
      <div class="panel" role="tabpanel" id={`panel-${family}`} aria-labelledby={`tab-${family}`} hidden={index !== 0} data-panel={family}>
        <ol class="stages">
          {STAGES[family].map((stage) => (
            <li class:list={['stage-card', { milestone: stage.level === null }]}>
              <p class="stage-level mono">{stage.level ?? 'milestone'}<span>{stage.typical}</span></p>
              <h3>{stage.name}</h3>
              <p>{stage.evidence}</p>
              <p class="undo"><span class="mono">undone by</span> {stage.undo}</p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="section wrap" aria-labelledby="consume-h">
    <h2 id="consume-h"><span class="mono"># </span>Consume the level you need</h2>
    <p class="sub">A processor publishes from one level up; its stream marks every later rise. Pick the first level your app may act on.</p>
    <div class="levels">
      {levels.map((item) => (
        <article class="level-card">
          <p class="stage-level mono">{item.level}</p>
          <h3>{item.title}</h3>
          <p>{item.use}</p>
          <pre class="mono"><code set:html={hlToml(item.toml)} /></pre>
          <pre class="mono"><code set:html={hlShell(item.cli)} /></pre>
        </article>
      ))}
    </div>
    <p class="sub note">The CLI follows Ethereum Mainnet; on any chain’s node, the SDK reads the same levels from one stream:</p>
    <TerminalFrame title="every level from one stream">
      <pre><code set:html={sdk.split('\n').map(hlTs).join('\n')} /></pre>
    </TerminalFrame>
    <p class="sub note">The Ethereum node runs the <code>blobs</code> processor, which names each blob transaction’s sender and the address it posts to: that is how the page knows whose blob it is. The hub fetches the blobs from a Beacon API and decodes the blocks inside.</p>
    <TerminalFrame title="which Ethereum block carries a rollup’s blobs">
      <pre><code set:html={blobs.split('\n').map(hlTs).join('\n')} /></pre>
    </TerminalFrame>
  </section>

  <section class="section wrap bedrock" aria-labelledby="bedrock-h">
    <h2 id="bedrock-h"><span class="mono"># </span>Two ways to rest on Ethereum</h2>
    <div class="cols">
      <div>
        <p>
          <strong>Data.</strong> Once the Ethereum block carrying a rollup block’s blob is final,
          anyone can derive the block from Ethereum and it can no longer change. Op-stack nodes call
          this finalized. It takes minutes, shows as a dashed line in each rollup’s row, and is not
          a level leani reports.
        </p>
        <p>
          <strong>Settlement.</strong> For withdrawals, Ethereum must also accept the rollup’s claim
          about its state, after a challenge window of days. That is leani’s <code>finalized</code> for
          a rollup, read from the settlement contracts’ logs in finalized Ethereum blocks, no RPC
          trusted. The picture’s right edge opens onto those days.
        </p>
      </div>
      <ul class="anchors mono">
        {anchored.map((chain) => <li><i class="chip" style={`--chain: ${chain.color}`}></i>{chain.label}<span>{chain.settlement!.via}, {chain.settlement!.typical}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="run-h">
    <h2 id="run-h"><span class="mono"># </span>Run it yourself</h2>
    <p class="sub">The example starts one node per chain, Ethereum’s with the blobs processor. Its hub follows them with the SDK, decodes the batches, reads fast confirmations from a beacon node, and streams this page. Op-stack nodes need a public address for their gossip.</p>
    <TerminalFrame title="shell">
      <pre><code set:html={run.split('\n').map(hlShell).join('\n')} /></pre>
    </TerminalFrame>
  </section>
  <Footer slot="after-main" />
</Base>

<script>
  import { Scene, duration, type Journey, type Passage } from '../lib/live/scene';
  import { liveFeed, replayFeed, type Feed, type Recording } from '../lib/live/feed';
  import { CHAINS, type Chain, type Level } from '../lib/live/model';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]')!;
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const dot = document.querySelector<HTMLElement>('[data-status-dot]')!;
  const expand = document.querySelector<HTMLButtonElement>('[data-expand]')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let feed: Feed | null = null;
  let present: string[] = CHAINS.map((chain) => chain.id);

  const selectFamily = (family: string) => {
    for (const tab of document.querySelectorAll<HTMLElement>('[data-tab]')) {
      tab.setAttribute('aria-selected', String(tab.dataset.tab === family));
    }
    for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
      panel.hidden = panel.dataset.panel !== family;
    }
  };
  for (const tab of document.querySelectorAll<HTMLElement>('[data-tab]')) {
    tab.addEventListener('click', () => selectFamily(tab.dataset.tab!));
  }

  const number = (value: number) => value.toLocaleString('en-US');
  const time = (seconds: number) => (seconds < 0.1 ? '<0.1 s' : duration(seconds));
  const label = (id: string) => CHAINS.find((chain) => chain.id === id)?.label ?? id;
  const levelName = (chain: Chain, level: Level) => ({
    unattested: 'seen, unattested',
    attested: chain.family === 'ethereum' ? 'attested by the sync committee' : 'signed by the sequencer',
    confirmed: 'confirmed by the fast confirmation rule',
    finalized: chain.family === 'ethereum' ? 'finalized' : 'settled on Ethereum',
  })[level];
  const scene = new Scene(canvas, {
    now: () => feed?.now() ?? Date.now(),
    reducedMotion,
    onExpand: (expanded) => {
      expand.setAttribute('aria-pressed', String(expanded));
      expand.textContent = expanded ? '◂ last 30 min' : 'days of settlement ▸';
    },
    onHover: (hover) => {
      if (!hover) {
        tip.hidden = true;
        return;
      }
      const { block, chain, batch } = hover;
      const lines = [`<b style="color:${chain.color}">${chain.label}</b> ${block ? `#${number(block.number)}` : 'batch'}`];
      if (block) {
        lines.push(`${levelName(chain, block.level)} · ${duration(block.age)} old`);
        if (block.txs !== null) lines.push(`${block.txs} txs${block.gas === null ? '' : ` · ${Math.round(block.gas * 100)}% gas`}`);
        const blobs = Object.entries(block.blobs ?? {});
        if (blobs.length) lines.push(blobs.map(([source, count]) => `${count} blob${count === 1 ? '' : 's'} ${source === 'other' ? 'from others' : `from ${label(source)}`}`).join('<br>'));
        if (chain.family !== 'ethereum' && !hover.followed) lines.push('<span style="color:#8fa89a">click to follow it</span>');
      }
      if (batch) {
        lines.push(`blocks #${number(batch.first)}–${number(batch.last)}: ${number(batch.last - batch.first + 1)}${batch.txs ? `, ${number(batch.txs)} txs` : ''}`);
        lines.push(`${batch.blobs ? `${batch.blobs} blobs on ` : 'in '}Ethereum #${number(batch.l1)}${batch.bytes ? ` · ${(batch.raw / batch.bytes).toFixed(1)}× compressed` : ''}`);
        if (batch.source === 'inbox') lines.push('named by its SequencerInbox call');
        if (batch.verified) lines.push('its parent hash matches the block leani has');
      }
      if (block?.hash) lines.push(`${block.hash.slice(0, 10)}…${block.hash.slice(-6)}`);
      tip.hidden = false;
      tip.innerHTML = lines.join('<br>');
      const left = Math.max(4, Math.min(hover.x + 14, canvas.clientWidth - tip.offsetWidth - 4));
      const top = Math.min(hover.y + 14, canvas.clientHeight - tip.offsetHeight - 8);
      tip.style.transform = `translate(${left}px, ${top}px)`;
    },
  });
  expand.addEventListener('click', () => scene.expand(expand.getAttribute('aria-pressed') !== 'true'));

  const handlers = {
    event: (event: Parameters<Scene['handle']>[0]) => scene.handle(event),
    reset: () => scene.reset(),
    state: (connected: boolean) => dot.classList.toggle('on', connected),
    chains: (chains: string[]) => {
      present = CHAINS.map((chain) => chain.id).filter((chain) => chains.includes(chain));
      scene.show(present);
    },
  };
  const hub = new URLSearchParams(location.search).get('hub');
  let source = '';
  if (hub) {
    feed = liveFeed(hub, handlers);
    source = `live from ${new URL(hub).host}`;
  } else {
    try {
      const response = await fetch('/finality/replay.json.gz');
      if (!response.ok) throw new Error(String(response.status));
      const bytes = new Uint8Array(await response.arrayBuffer());
      // A server may send it as `Content-Encoding: gzip`, which the browser has unpacked already.
      const packed = bytes[0] === 0x1f && bytes[1] === 0x8b;
      const text = packed
        ? await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text()
        : new TextDecoder().decode(bytes);
      const recording = JSON.parse(text) as Recording;
      feed = replayFeed(recording, handlers);
      source = `replay of ${new Date(recording.recordedAt).toISOString().slice(0, 16).replace('T', ' ')} UTC`;
    } catch {
      source = 'no live hub and no recording';
    }
  }

  const put = (element: HTMLElement | null | undefined, value: string) => {
    if (element && element.textContent !== value) element.textContent = value;
  };
  const range = (pair: [number, number] | null) => (pair ? `${duration(pair[0])} – ${duration(pair[1])}` : '—');
  const about = (estimated: boolean) => (estimated ? '~' : '');
  const keep = (text: string) => text.replaceAll(' ', '\u00a0');

  const follow = document.querySelector<HTMLElement>('[data-follow]')!;
  const followTitle = document.querySelector<HTMLElement>('[data-follow-title]')!;
  const followStages = document.querySelector<HTMLElement>('[data-follow-stages]')!;
  const showJourney = (journey: Journey | null) => {
    follow.hidden = !journey;
    if (!journey) return;
    const at = (ms: number | null) => (ms === null ? null : Math.max(0, ms / 1000 - journey.born));
    const rows: [string, number | null, string][] = [
      ['signed', at(journey.attestedAt ?? journey.seen), ''],
      ['in a blob', journey.batch ? Math.max(0, journey.batch.l1Time - journey.born) : null, journey.batch ? `Ethereum #${number(journey.batch.l1)}` : 'waiting for the batcher'],
      ['confirmed', at(journey.l1?.confirmedAt ?? null), ''],
      ['final', at(journey.l1?.finalizedAt ?? null), ''],
      ['settled', null, journey.chain.settlement?.typical ?? '—'],
    ];
    followTitle.style.color = journey.chain.color;
    put(followTitle, `${journey.chain.label} #${number(journey.number)}${journey.txs === null ? '' : ` · ${journey.txs} txs`}`);
    const html = rows.map(([name, seconds, detail]) =>
      `<li class="${seconds === null ? 'pending' : 'done'}">${name}${seconds === null ? '' : ` <b>${seconds < 0.1 ? time(seconds) : `+${time(seconds)}`}</b>`}${detail ? ` <em>${detail}</em>` : ''}</li>`).join('');
    if (followStages.innerHTML !== html) followStages.innerHTML = html;
  };
  // A click outside the picture lets the followed block go too, except on the strip about it.
  document.addEventListener('click', (event) => {
    if (event.target !== canvas && !follow.contains(event.target as Node)) scene.unfollow();
    showJourney(scene.journey());
  });

  const cells = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-chain]')].map((row) => [row.dataset.chain!, row]),
  );
  // Narrow screens show one chain's row at a time, picked with these buttons.
  const picks = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  let picked = CHAINS[0].id;
  const pick = (chain: string) => {
    picked = chain;
    for (const button of picks) button.setAttribute('aria-pressed', String(button.dataset.pick === chain));
    for (const [id, row] of cells) row.classList.toggle('picked', id === chain);
  };
  for (const button of picks) button.addEventListener('click', () => pick(button.dataset.pick!));
  const rollupCells = (passage: Passage | null) => {
    if (!passage) return { posted: '—', confirmed: '—', finalized: '—' };
    const posted = passage.postedAfter;
    const confirmed = posted && passage.confirmedAfterPosting !== null
      ? `${about(passage.estimated.confirmed)}${range([posted[0] + passage.confirmedAfterPosting, posted[1] + passage.confirmedAfterPosting])}`
      : '—';
    return {
      // A narrow list breaks this between its two parts only.
      posted: posted ? `${keep(range(posted))}${passage.every ? ` · ${keep(`every ${duration(passage.every)}`)}` : ''}` : 'no batch yet',
      confirmed,
      finalized: passage.finalAfter ? `${about(passage.estimated.final)}${range(passage.finalAfter)}` : '—',
    };
  };
  const refresh = () => {
    const summaries = scene.summaries();
    const following = summaries.filter((summary) => summary.head !== null).length;
    status.textContent = `${source} · ${following} of ${present.length} chains`;
    for (const button of picks) button.hidden = !present.includes(button.dataset.pick!);
    if (!present.includes(picked) && present.length) pick(present[0]);
    for (const summary of summaries) {
      const row = cells.get(summary.chain.id);
      if (!row) continue;
      row.hidden = !present.includes(summary.chain.id);
      row.classList.toggle('quiet', summary.head === null);
      const cell = (name: string) => row.querySelector<HTMLElement>(`[data-cell="${name}"]`);
      put(cell('block'), summary.blockSeconds === null ? '—' : duration(summary.blockSeconds));
      put(cell('seen'), summary.seen === null ? '—' : duration(summary.seen));
      put(cell('attested'), summary.attested === null ? '—' : duration(summary.attested));
      if (summary.chain.family === 'ethereum') {
        put(cell('posted'), 'is the settlement layer');
        put(cell('confirmed'), summary.confirmed === null ? '—' : duration(summary.confirmed));
        put(cell('finalized'), summary.finalized === null ? '—' : duration(summary.finalized));
        put(cell('settled'), '—');
        continue;
      }
      const values = rollupCells(scene.passage(summary.chain.id));
      put(cell('posted'), values.posted);
      put(cell('confirmed'), values.confirmed);
      put(cell('finalized'), values.finalized);
      put(cell('settled'), summary.finalizedAge !== null ? `newest ${duration(summary.finalizedAge)} old` : summary.chain.settlement?.typical ?? '—');
    }
    showJourney(scene.journey());
  };
  refresh();
  window.setInterval(refresh, 1000);
</script>

<style>
  .hero { padding-block: 3.5rem 1.5rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-block: 0.6rem 1rem; max-width: 22ch; }
  .lede { max-width: 46rem; color: var(--ink-dim); font-size: 1.08rem; }
  .status { margin-top: 1.25rem; display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.8rem; color: var(--ink-dim); border: 1px solid var(--panel-edge); border-radius: 999px; padding: 0.3rem 0.8rem; }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: #536b5e; }
  .status .dot:global(.on) { background: var(--accent); box-shadow: 0 0 10px var(--accent); }

  .follow { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1.2rem; padding-block: 0.6rem 0.9rem; font-size: 0.76rem; }
  .follow[hidden] { display: none; }
  .follow ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.6rem; }
  .follow :global(li + li)::before { content: '→'; color: #536b5e; margin-right: 0.6rem; }
  .follow :global(li.pending) { color: #536b5e; }
  .follow :global(li b) { font-weight: 600; color: var(--accent); }
  .follow :global(li em) { font-style: normal; color: var(--ink-dim); }

  .stage-wrap { border-block: 1px solid var(--panel-edge); background: #0b0f0d; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; padding-block: 0.8rem; font-size: 0.74rem; color: var(--ink-dim); align-items: center; }
  .legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .swatch { display: inline-block; width: 11px; height: 11px; border-radius: 3px; }
  .swatch.block { background: #ff4d5e; width: 8px; height: 8px; border-radius: 1px; }
  .swatch.batch { width: 18px; height: 4px; border-radius: 1px; background: #ff4d5e; opacity: 0.7; }
  .swatch.slab { width: 26px; height: 10px; border: 1.2px solid #9aa8ff; background: #9aa8ff2a; display: inline-flex; gap: 2px; padding: 1.5px; }
  .swatch.slab i { width: 3px; background: #3d7bff; }
  .swatch.slab i:first-child { background: #ff4d5e; }
  .swatch.slab.seen { width: 18px; background: #9aa8ff10; }
  .swatch.slab.attested { width: 18px; }
  .swatch.slab.confirmed { width: 18px; background: #9aa8ff4d; border: 1.6px solid #d6dbff; }
  .swatch.slab.final { width: 18px; background: #2b3c33; border-color: var(--accent); }
  .swatch.reorg { background: #ff5c5c; transform: rotate(45deg) scale(0.75); }
  .buttons { margin-left: auto; display: inline-flex; gap: 0.5rem; }
  .toggle { font: inherit; color: var(--accent); background: none; border: 1px solid var(--panel-edge); border-radius: 6px; padding: 0.25rem 0.6rem; cursor: pointer; }
