---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Pipeline from '../components/Pipeline.astro';
import Delivery from '../components/Delivery.astro';
import Showcase from '../components/Showcase.astro';
import CostTable from '../components/CostTable.astro';
import Boundary from '../components/Boundary.astro';
import Features from '../components/Features.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
---
<Base
  title="leani — the lean Ethereum indexing node"
  description="Leani backfills Ethereum history, follows the live chain, and deterministically reduces blocks into the state, outputs, and durable streams your application chooses to retain."
>
  <SideNav />
  <Hero />
  <Story />
  <Pipeline />
  <Delivery />
  <Showcase />
  <CostTable />
  <Boundary />
  <Features />
  <Quickstart />
  <Footer slot="after-main" />
</Base>
