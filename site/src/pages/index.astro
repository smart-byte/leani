---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Replaces from '../components/Replaces.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Rollups from '../components/Rollups.astro';
import BuiltWith from '../components/BuiltWith.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
---
<Base
  title="leani — the lean Ethereum indexing node"
  description="An indexing node you run yourself: it backfills history from public datasets, follows Ethereum and its rollups live, and serves your app's data over JSON-RPC, HTTP, and a TypeScript SDK, with no API key and no per-request bill."
>
  <Header slot="before-main" />
  <SideNav />
  <Hero />
  <Replaces />
  <HowItWorks />
  <Rollups />
  <BuiltWith />
  <Quickstart />
  <Footer slot="after-main" />
</Base>
