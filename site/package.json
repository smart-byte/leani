{
  "name": "@leani/site",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "brand:update": "bun scripts/generate-brand-assets.ts",
    "dev": "bun run docs:prepare && astro dev",
    "build": "bun run docs:prepare && astro build",
    "preview": "astro preview",
    "check": "bun run docs:check && astro check && bun test",
    "docs:prepare": "bun ../scripts/docs/prepare.ts",
    "docs:check": "bun ../scripts/docs/check.ts",
    "docs:update": "bun ../scripts/docs/update.ts",
    "docs:watch-check": "bun run docs:prepare && bun ../scripts/docs/watch-check.ts",
    "examples:check": "bun ../scripts/docs/verify-examples.ts --shell --typescript",
    "size:check": "bun ../scripts/docs/asset-budget.ts",
    "search:check": "bun ../scripts/docs/search-check.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "astro": "7.3.5",
    "astro-expressive-code": "0.44.2",
    "github-slugger": "2.0.0",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.4.2",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
